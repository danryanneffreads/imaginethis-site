---
// CTASection.astro
// Reusable call-to-action section for encouraging engagement

interface Props {
  heading: string;
  description?: string;
  button_text?: string;
  button_link?: string;
  dark?: boolean;
}

const { 
  heading, 
  description, 
  button_text = "Get Started", 
  button_link = "#",
  dark = false
} = Astro.props;

const bgClass = dark ? "bg-gray-900 text-white" : "bg-amber-50 text-gray-900";
const buttonClass = dark 
  ? "bg-amber-700 text-white hover:bg-amber-800" 
  : "bg-amber-700 text-white hover:bg-amber-800";
---

<section class={`py-16 ${bgClass}`}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl md:text-4xl font-bold mb-4">{heading}</h2>
    {description && (
      <p class={`text-lg mb-8 ${dark ? "text-gray-300" : "text-gray-600"}`}>
        {description}
      </p>
    )}
    {button_text && (
      <a 
        href={button_link}
        class={`inline-block px-8 py-3 rounded-lg font-semibold transition ${buttonClass}`}
      >
        {button_text}
      </a>
    )}
  </div>
</section>
