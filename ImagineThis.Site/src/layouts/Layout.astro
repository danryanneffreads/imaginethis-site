---
// Layout.astro
// Base layout for all pages - includes Header, Footer, and meta setup

import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title = "ImagineThis.Site - Websites Built on How You Serve", description = "Your website is part of your business operations. When it reflects how you actually serve people, everything gets easier." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      :root {
        --font-serif: 'Lora', serif;
        --font-sans: 'Inter', sans-serif;
      }
    </style>
  </head>
  <body class="flex flex-col min-h-screen bg-white" style="font-family: var(--font-sans)">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
