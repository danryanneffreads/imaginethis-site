---
// sync-coffee/reserve/index.astro
// Meeting room reservation form

import SyncCoffeeLayout from "../../../layouts/SyncCoffeeLayout.astro";
---

<SyncCoffeeLayout 
  title="Reserve a Space - Synchronize Coffee"
  description="Reserve a meeting space or work area at Synchronize Coffee."
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-stone-50 dark:from-emerald-950 to-white dark:to-gray-950 py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-serif font-bold text-emerald-900 dark:text-emerald-300 mb-6">Reserve a Space</h1>
      <p class="text-lg text-gray-700 dark:text-gray-300">Need a workspace, meeting room, or event space? We have cozy corners and community tables.</p>
    </div>
  </section>

  <!-- Rooms Section -->
  <section class="py-16 bg-white dark:bg-gray-950">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
      <h2 class="text-3xl font-serif font-bold text-gray-900 dark:text-white mb-12">Our Spaces</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- The Greenhouse -->
        <div class="bg-stone-50 dark:bg-emerald-900 p-8 rounded-lg border border-stone-200 dark:border-emerald-800">
          <img src="https://picsum.photos/400/300?random=20" alt="The Greenhouse meeting room" class="w-full h-48 object-cover rounded mb-6" />
          <h3 class="text-2xl font-serif font-bold text-gray-900 dark:text-white mb-2">The Greenhouse</h3>
          <p class="text-sm text-emerald-800 dark:text-stone-200 font-semibold mb-3">Seats 4-6 people</p>
          <p class="text-gray-700 dark:text-gray-300 text-sm leading-relaxed">
            Private corner room with natural light, whiteboard, and comfortable seating. Perfect for client meetings, team brainstorms, or focused work sessions.
          </p>
        </div>

        <!-- The Study -->
        <div class="bg-stone-50 dark:bg-emerald-900 p-8 rounded-lg border border-stone-200 dark:border-emerald-800">
          <img src="https://picsum.photos/400/300?random=21" alt="The Study workspace" class="w-full h-48 object-cover rounded mb-6" />
          <h3 class="text-2xl font-serif font-bold text-gray-900 dark:text-white mb-2">The Study</h3>
          <p class="text-sm text-emerald-800 dark:text-stone-200 font-semibold mb-3">Seats 2-3 people</p>
          <p class="text-gray-700 dark:text-gray-300 text-sm leading-relaxed">
            Quiet booth perfect for one-on-one meetings, interviews, or deep work. Complete with power outlets and complimentary coffee.
          </p>
        </div>

        <!-- Community Table -->
        <div class="bg-stone-50 dark:bg-emerald-900 p-8 rounded-lg border border-stone-200 dark:border-emerald-800">
          <img src="https://picsum.photos/400/300?random=22" alt="Community table seating" class="w-full h-48 object-cover rounded mb-6" />
          <h3 class="text-2xl font-serif font-bold text-gray-900 dark:text-white mb-2">Community Table</h3>
          <p class="text-sm text-emerald-800 dark:text-stone-200 font-semibold mb-3">Open seating</p>
          <p class="text-gray-700 dark:text-gray-300 text-sm leading-relaxed">
            Open seating area perfect for solo work, casual meetings, or just enjoying great coffee. Great community vibe and WiFi.
          </p>
        </div>

        <!-- Amenities -->
        <div class="bg-stone-50 dark:bg-emerald-900 p-8 rounded-lg border border-stone-200 dark:border-emerald-800">
          <h3 class="text-2xl font-serif font-bold text-gray-900 dark:text-white mb-6">What's Included</h3>
          <ul class="space-y-3 text-gray-700 dark:text-gray-300 text-sm">
            <li class="flex items-start gap-3">
              <span class="text-emerald-700 dark:text-emerald-400 font-bold"><span class="text-emerald-700 dark:text-emerald-400 font-bold">✓</span></span>
              <span>Complimentary coffee and tea</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-emerald-700 dark:text-emerald-400 font-bold"><span class="text-emerald-700 dark:text-emerald-400 font-bold">✓</span></span>
              <span>Free high-speed WiFi</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-emerald-700 dark:text-emerald-400 font-bold"><span class="text-emerald-700 dark:text-emerald-400 font-bold">✓</span></span>
              <span>Power outlets and USB charging</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-emerald-700 dark:text-emerald-400 font-bold"><span class="text-emerald-700 dark:text-emerald-400 font-bold">✓</span></span>
              <span>Bathroom access</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-emerald-700 dark:text-emerald-400 font-bold"><span class="text-emerald-700 dark:text-emerald-400 font-bold">✓</span></span>
              <span>Bike parking</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Reservation Form -->
    <div class="bg-stone-50 dark:bg-emerald-950 py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-serif font-bold text-gray-900 dark:text-white mb-8 text-center">Request a Reservation</h2>
        
        <form class="space-y-6 bg-white dark:bg-gray-900 p-8 rounded-lg" onsubmit="handleReservationSubmit(event)">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-sm font-semibold text-gray-900 dark:text-white mb-2">Your Name *</label>
              <input 
                type="text" 
                id="name" 
                name="name"
                class="w-full px-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white rounded focus:outline-none focus:border-stone-500 dark:focus:border-emerald-400 transition"
                required
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-semibold text-gray-900 dark:text-white mb-2">Email *</label>
              <input 
                type="email" 
                id="email" 
                name="email"
                class="w-full px-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white rounded focus:outline-none focus:border-stone-500 dark:focus:border-emerald-400 transition"
                required
              />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="room" class="block text-sm font-semibold text-gray-900 dark:text-white mb-2">Room Selection *</label>
              <select 
                id="room" 
                name="room"
                class="w-full px-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white rounded focus:outline-none focus:border-stone-500 dark:focus:border-emerald-400 transition"
                required
              >
                <option value="">Select a space</option>
                <option value="greenhouse">The Greenhouse (4-6 people)</option>
                <option value="study">The Study (2-3 people)</option>
                <option value="community">Community Table (open seating)</option>
              </select>
            </div>

            <div>
              <label for="date" class="block text-sm font-semibold text-gray-900 dark:text-white mb-2">Preferred Date *</label>
              <input 
                type="text" 
                id="date" 
                name="date"
                placeholder="e.g., Next Tuesday, June 15"
                class="w-full px-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white rounded focus:outline-none focus:border-stone-500 dark:focus:border-emerald-400 transition"
                required
              />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="time" class="block text-sm font-semibold text-gray-900 dark:text-white mb-2">Time *</label>
              <input 
                type="text" 
                id="time" 
                name="time"
                placeholder="e.g., 2:00 PM - 4:00 PM"
                class="w-full px-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white rounded focus:outline-none focus:border-stone-500 dark:focus:border-emerald-400 transition"
                required
              />
            </div>

            <div>
              <label for="duration" class="block text-sm font-semibold text-gray-900 dark:text-white mb-2">Duration *</label>
              <select 
                id="duration" 
                name="duration"
                class="w-full px-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white rounded focus:outline-none focus:border-stone-500 dark:focus:border-emerald-400 transition"
                required
              >
                <option value="">Select duration</option>
                <option value="1hour">1 hour</option>
                <option value="2hours">2 hours</option>
                <option value="3hours">3 hours</option>
                <option value="4hours">4+ hours</option>
              </select>
            </div>
          </div>

          <div>
            <label for="purpose" class="block text-sm font-semibold text-gray-900 dark:text-white mb-2">What's This For? *</label>
            <textarea 
              id="purpose" 
              name="purpose"
              rows="3"
              placeholder="Meeting? Solo work? Team brainstorm? Event?"
              class="w-full px-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white rounded focus:outline-none focus:border-stone-500 dark:focus:border-emerald-400 transition"
              required
            ></textarea>
          </div>

          <div>
            <label for="notes" class="block text-sm font-semibold text-gray-900 dark:text-white mb-2">Additional Notes (optional)</label>
            <textarea 
              id="notes" 
              name="notes"
              rows="3"
              placeholder="Any special requests or accommodations?"
              class="w-full px-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white rounded focus:outline-none focus:border-stone-500 dark:focus:border-emerald-400 transition"
            ></textarea>
          </div>

          <button 
            type="submit"
            class="w-full bg-emerald-700 dark:bg-emerald-600 text-white px-6 py-4 font-semibold hover:bg-emerald-800 dark:hover:bg-emerald-700 transition rounded-lg"
          >
            Request Reservation
          </button>
        </form>

        <p class="text-sm text-gray-600 dark:text-gray-400 mt-6 text-center">
          This is a demo. Your information won't be collected.
        </p>
      </div>
    </div>
  </section>

  <script>
    function handleReservationSubmit(e) {
      e.preventDefault();
      window.location.href = '/sync-coffee/reserve/confirmed/';
      return false;
    }
  </script>
</SyncCoffeeLayout>
