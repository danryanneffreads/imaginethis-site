---
// Card.astro
// Reusable card component for showcasing concept sites or features

interface Props {
  title: string;
  description: string;
  image?: string;
  icon?: string;
  link?: string;
}

const { title, description, image, icon, link } = Astro.props;
---

<div class="bg-white rounded-lg shadow-md hover:shadow-lg transition overflow-hidden">
  {image && (
    <img src={image} alt={title} class="w-full h-48 object-cover" />
  )}
  {icon && (
    <div class="h-12 bg-amber-100 flex items-center justify-center text-2xl">
      {icon}
    </div>
  )}
  <div class="p-6">
    <h3 class="text-xl font-bold text-gray-900 mb-3">{title}</h3>
    <p class="text-gray-600 text-sm mb-4">{description}</p>
    {link && (
      <a href={link} class="text-amber-700 font-semibold hover:text-amber-900 transition inline-flex items-center gap-2">
        Learn More →
      </a>
    )}
  </div>
</div>
