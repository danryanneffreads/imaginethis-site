---
// Card.astro
// Reusable card component for showcasing concept sites or features
// Entire card becomes clickable when `link` is provided.

interface Props {
  title: string;
  description: string;
  image?: string;
  icon?: string;
  link?: string;
}

const { title, description, image, icon, link } = Astro.props;
---

{
  link ? (
    <a
      href={link}
      class="group block bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 hover:border-gray-400 dark:hover:border-gray-700 transition overflow-hidden focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-gray-900"
    >
      {image && (
        <img src={image} alt={title} class="w-full h-56 object-cover" />
      )}

      {icon && (
        <div class="h-12 bg-gray-100 dark:bg-gray-800 flex items-center justify-center text-2xl">
          {icon}
        </div>
      )}

      <div class="p-6">
        <h3 class="text-xl font-serif font-bold text-gray-900 dark:text-white mb-3 group-hover:underline">
          {title}
        </h3>
        <p class="text-gray-700 dark:text-gray-300 text-base mb-4 leading-relaxed">
          {description}
        </p>
        <span class="text-gray-900 dark:text-gray-200 font-semibold inline-flex items-center gap-2 text-sm">
          Learn More →
        </span>
      </div>
    </a>
  ) : (
    <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 hover:border-gray-400 dark:hover:border-gray-700 transition overflow-hidden">
      {image && (
        <img src={image} alt={title} class="w-full h-56 object-cover" />
      )}

      {icon && (
        <div class="h-12 bg-gray-100 dark:bg-gray-800 flex items-center justify-center text-2xl">
          {icon}
        </div>
      )}

      <div class="p-6">
        <h3 class="text-xl font-serif font-bold text-gray-900 dark:text-white mb-3">
          {title}
        </h3>
        <p class="text-gray-700 dark:text-gray-300 text-base mb-4 leading-relaxed">
          {description}
        </p>
      </div>
    </div>
  )
}
