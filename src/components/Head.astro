---
// src/components/Head.astro

const {
  title = 'ImagineThis.Site',
  description = 'A calm, structured studio for concept sites, private client drafts, and clear resources on modern web building.',
  image, // per-page override: absolute URL or /relative path
  noindex = false,
  status = 'published',
} = Astro.props;

const isUnpublished = status === 'unpublished';
const canonical = Astro.url?.href ?? 'https://imaginethis.site';

// Default OG image (change to .png if that's what you exported)
const DEFAULT_OG = '/images/og-default.jpg';

// Make og:image absolute for social scrapers
const siteOrigin = (() => {
  try {
    return new URL(canonical).origin;
  } catch {
    return '';
  }
})();
const toAbsolute = (u) => {
  if (!u) return undefined;
  try {
    return u.startsWith('http') ? u : siteOrigin ? `${siteOrigin}${u}` : u;
  } catch {
    return u;
  }
};
const ogImage = toAbsolute(image ?? DEFAULT_OG);
---

<title>{title}</title>
{description && <meta name="description" content={description} />}
{
  (noindex || isUnpublished) && (
    <meta name="robots" content="noindex, nofollow" />
  )
}
<link rel="canonical" href={canonical} />

<!-- Favicons -->
<link rel="icon" type="image/svg+xml" sizes="any" href="/images/favicon.svg" />
<link rel="icon" href="/favicon.ico" />

<!-- App icons -->
<link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
<!-- 180x180 -->
<link
  rel="icon"
  type="image/png"
  sizes="192x192"
  href="/images/android-chrome-192x192.png"
/>
<link rel="icon" type="image/png" sizes="512x512" href="/images/icon-512.png" />

<!-- Safari pinned tab (macOS). If caching is stubborn, rename file and update this href. -->
<link rel="mask-icon" href="/mask-icon.svg" color="#1D4ED8" />

<!-- Theme colors -->
<meta
  name="theme-color"
  content="#0B1020"
  media="(prefers-color-scheme: dark)"
/>
<meta
  name="theme-color"
  content="#FFFFFF"
  media="(prefers-color-scheme: light)"
/>

<!-- Open Graph / Twitter -->
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{ogImage && <meta property="og:image" content={ogImage} />}
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
