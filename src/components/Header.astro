---
const nav = [
  { href: "/", label: "Home" },
  { href: "/#concept", label: "Concept" },
  { href: "/web-builders", label: "Web Builders Guide" },
  { href: "mailto:danryanneff@gmail.com", label: "Contact" }
];

const pathname = Astro.url?.pathname ?? "/";
const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  if (href.startsWith("/#")) return false;
  return pathname.startsWith(href);
};
---

<header class="sticky top-0 z-40 bg-white/90 backdrop-blur border-b border-gray-200 dark:bg-gray-950/70 dark:border-gray-800">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between">
    <a href="/" class="font-semibold tracking-tight text-gray-900 dark:text-white">ImagineThis.Site</a>
    <nav class="flex items-center gap-4 sm:gap-6 text-sm" aria-label="Main">
      {nav.map((item) => (
        <a
          href={item.href}
          class={`hover:text-gray-900 dark:hover:text-white ${
            isActive(item.href) ? "text-gray-900 dark:text-white" : "text-gray-700 dark:text-gray-300"
          }`}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
      <!-- Dark mode toggle -->
      <button id="theme-toggle" type="button" class="p-2 rounded-lg hover:bg-stone-100 dark:hover:bg-gray-800 transition" aria-label="Toggle dark mode">
        <!-- Sun (shows in dark mode) -->
        <svg class="w-5 h-5 hidden dark:block text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414z" clip-rule="evenodd"/></svg>
        <!-- Moon (shows in light mode) -->
        <svg class="w-5 h-5 block dark:hidden text-gray-700" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
      </button>
    </nav>
  </div>
</header>