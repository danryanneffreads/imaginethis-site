---
// src/components/Header.astro

const nav = [
  { href: '/#concepts', label: 'Concepts' },
  { href: '/web-builders', label: 'Guides' },
  { href: '/process', label: 'Process' },
];

const pathname = Astro.url?.pathname ?? '/';
const isActive = (href: string) => {
  // Treat hash anchors as non-route for "active" state
  if (href.startsWith('/#')) return false;
  return pathname === href || pathname.startsWith(href + '/');
};
---

<header
  class="sticky top-0 z-40 bg-white/90 backdrop-blur border-b border-gray-200 dark:bg-gray-950/70 dark:border-gray-800"
>
  <div
    class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between"
  >
    <!-- Site name links to home -->
    <a
      href="/"
      class="font-semibold tracking-tight text-gray-900 dark:text-white"
      >ImagineThis.Site</a
    >

    <!-- Desktop nav -->
    <nav
      class="hidden sm:flex items-center gap-4 sm:gap-6 text-sm"
      aria-label="Main"
    >
      {
        nav.map((item) => (
          <a
            href={item.href}
            class={`hover:text-gray-900 dark:hover:text-white ${
              isActive(item.href)
                ? 'text-gray-900 dark:text-white'
                : 'text-gray-700 dark:text-gray-300'
            }`}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Right-side controls -->
    <div class="flex items-center gap-2">
      <!-- Theme toggle -->
      <button
        id="theme-toggle"
        type="button"
        class="p-2 rounded-lg hover:bg-stone-100 dark:hover:bg-gray-800 transition"
        aria-label="Toggle dark mode"
      >
        <!-- Sun (shows in dark mode) -->
        <svg
          class="hidden dark:block h-5 w-5 text-yellow-400"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M12 3v2m0 14v2m7.071-13.071-1.414 1.414M6.343 17.657l-1.414 1.414M21 12h-2M5 12H3m13.657 6.657-1.414-1.414M7.757 7.757 6.343 6.343M12 8.25a3.75 3.75 0 1 1 0 7.5 3.75 3.75 0 0 1 0-7.5Z"
          ></path>
        </svg>
        <!-- Moon (shows in light mode) -->
        <svg
          class="block dark:hidden h-5 w-5 text-gray-700 dark:text-gray-300"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79Z"></path>
        </svg>
      </button>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="sm:hidden p-2 rounded-lg hover:bg-stone-100 dark:hover:bg-gray-800 transition"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <!-- Hamburger -->
        <svg
          class="h-5 w-5 text-gray-700 dark:text-gray-300"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile nav panel -->
  <div
    id="mobile-menu"
    class="sm:hidden hidden border-t border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950"
  >
    <nav
      class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-3 flex flex-col gap-2 text-sm"
      aria-label="Mobile"
    >
      {
        nav.map((item) => (
          <a
            href={item.href}
            class={`block py-2 ${
              isActive(item.href)
                ? 'text-gray-900 dark:text-white'
                : 'text-gray-700 dark:text-gray-300'
            } hover:text-gray-900 dark:hover:text-white`}
            data-menu-close
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<!-- Behavior: theme toggle + mobile menu -->
<script>
  (function () {
    // Theme toggle
    const root = document.documentElement;
    const themeBtn = document.getElementById('theme-toggle');
    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        const isDark = root.classList.toggle('dark');
        try {
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        } catch (e) {}
      });
    }

    // Mobile menu toggle
    const menuBtn = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!menuBtn || !menu) return;

    function closeMenu() {
      menu.classList.add('hidden');
      menuBtn.setAttribute('aria-expanded', 'false');
    }

    function openMenu() {
      menu.classList.remove('hidden');
      menuBtn.setAttribute('aria-expanded', 'true');
    }

    menuBtn.addEventListener('click', () => {
      const expanded = menuBtn.getAttribute('aria-expanded') === 'true';
      expanded ? closeMenu() : openMenu();
    });

    // Close on link click
    menu.querySelectorAll('[data-menu-close]').forEach((link) => {
      link.addEventListener('click', () => closeMenu());
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });
  })();
</script>
