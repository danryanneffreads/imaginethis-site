---
// Hero.astro
// Reusable hero section component with artwork accent and texture

interface Props {
  title: string;
  subtitle: string;
  smallText?: string;
  cta_text?: string;
  cta_link?: string;
}

const { title, subtitle, smallText, cta_text = "Get Started", cta_link = "#" } = Astro.props;
---

<section class="bg-white dark:bg-gray-950 text-gray-900 dark:text-white py-24 md:py-32 relative overflow-hidden">
  {/* Artwork accent - centered, faded, slow rotation */}
  <div class="absolute inset-0 flex items-center justify-center -mt-12 pointer-events-none overflow-hidden">
    <div class="w-96 h-96 md:w-[500px] md:h-[500px] opacity-[0.15] dark:opacity-[0.2] animate-spin-slow">
      <img src="/mandala-cerulean-gyroscope-660.webp" alt="" class="w-full h-full object-cover rounded-full" />
    </div>
  </div>

  {/* Subtle texture overlay */}
  <div class="absolute inset-0 opacity-[0.015] dark:opacity-[0.03] pointer-events-none bg-noise" style="background-image: url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22100%22 height=%22100%22><filter id=%22noise%22><feTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 result=%22noise%22/></filter><rect width=%22100%22 height=%22100%22 fill=%22%23000%22 filter=%22url(%23noise)%22/></svg>');"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <h1 class="text-4xl md:text-6xl font-serif font-bold mb-8 max-w-4xl mx-auto leading-tight dark:text-white">{title}</h1>
    <p class="text-lg md:text-xl text-gray-700 dark:text-gray-300 mb-8 max-w-3xl mx-auto leading-relaxed">{subtitle}</p>
    {smallText && (
      <p class="text-base text-gray-600 dark:text-gray-400 mb-10 max-w-2xl mx-auto">{smallText}</p>
    )}
    {cta_text && (
      <a 
        href={cta_link} 
        class="inline-block bg-gray-900 dark:bg-white text-white dark:text-gray-900 px-8 py-3 font-semibold hover:bg-gray-800 dark:hover:bg-gray-100 transition"
      >
        {cta_text}
      </a>
    )}
  </div>
</section>

<style>
  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .animate-spin-slow {
    animation: spin-slow 90s linear infinite;
  }
</style>
