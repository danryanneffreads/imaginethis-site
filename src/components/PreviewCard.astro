---
const {
  title = "",
  description = "",
  href = "#",
  image = ""
} = Astro.props;
---

<a class="preview-card" href={href}>
  <div class="preview-card-image">
    <img src={image} alt={title} />
  </div>

  <div class="preview-card-content">
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
</a>