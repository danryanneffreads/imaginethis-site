---
// Unpublished.astro
// Component shown when a page has status: "unpublished"
// The page still renders (no 404) but displays a message that it's been taken down
---

<div class="min-h-screen flex items-center justify-center bg-gray-50 dark:bg-gray-950">
  <div class="max-w-md mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="text-4xl font-serif font-bold text-gray-900 dark:text-white mb-4">
      Page Taken Down
    </h1>
    <p class="text-lg text-gray-700 dark:text-gray-300 mb-8 leading-relaxed">
      This page is no longer available. It may have been removed or replaced.
    </p>
    <a 
      href="/" 
      class="inline-block bg-gray-900 dark:bg-white text-white dark:text-gray-900 px-6 py-2 font-semibold hover:bg-gray-800 dark:hover:bg-gray-100 transition rounded-lg"
    >
      Back to Home
    </a>
  </div>
</div>
