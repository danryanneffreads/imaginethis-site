---
interface PhotoItem {
  src: string;
  alt: string;
  projectSlug: string;
  projectTitle: string;
  projectType: string;
  spaces: string[];
  materials: string[];
}
const { photo } = Astro.props as { photo: PhotoItem };
---

<a
  href={`/concept/hearthworks-architecture/projects/${photo.projectSlug}/`}
  class="group rounded-lg bg-white/80 dark:bg-gray-900/40 border border-stone-200 dark:border-stone-800 overflow-hidden hover:shadow-md transition-colors block"
>
  <img
    src={photo.src}
    alt={photo.alt}
    class="w-full h-48 object-cover border-b border-stone-200 dark:border-stone-800"
    loading="lazy"
    decoding="async"
  />
  <div class="p-4">
    <div class="flex items-center justify-between gap-2">
      <h3
        class="text-sm font-semibold text-gray-900 dark:text-white line-clamp-1"
      >
        {photo.projectTitle}
      </h3>
      <span class="hw-chip text-xs">{photo.projectType}</span>
    </div>
    <p class="text-sm text-gray-700 dark:text-gray-300 mt-1 line-clamp-2">
      {photo.alt}
    </p>
    <div class="mt-2 flex flex-wrap gap-2">
      {
        photo.spaces
          .slice(0, 1)
          .map((s) => <span class="hw-chip text-xs">{s}</span>)
      }
      <span class="hw-chip text-xs"
        >{photo.materials.slice(0, 2).join(' · ')}</span
      >
    </div>
  </div>
</a>
