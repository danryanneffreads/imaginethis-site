---
import type { Project } from '../../data/hearthworks-projects';
import { isElsewhere } from '../../data/hearthworks-projects';
const { project } = Astro.props as { project: Project };
const elsewhere = isElsewhere(project.location);
---

<a
  href={`/concept/hearthworks-architecture/projects/${project.slug}/`}
  class="group rounded-lg bg-white/80 dark:bg-gray-900/40 border border-stone-200 dark:border-stone-800 overflow-hidden hover:shadow-md transition-colors"
>
  <img
    src={project.hero}
    alt={project.title}
    class="w-full h-48 object-cover border-b border-stone-200 dark:border-stone-800"
    loading="lazy"
    decoding="async"
  />
  <div class="p-4">
    <div class="flex items-center justify-between gap-2">
      <h3
        class="text-lg font-semibold text-gray-900 dark:text-white group-hover:underline"
      >
        {project.title}
      </h3>
      {elsewhere && <span class="hw-chip hw-elsewhere">Elsewhere</span>}
    </div>
    <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
      {project.location}
    </p>
    <div class="mt-2 flex flex-wrap gap-2">
      <span class="hw-chip">{project.type}</span>
      <span class="hw-chip">{project.materials.slice(0, 2).join(' · ')}</span>
    </div>
  </div>
</a>
