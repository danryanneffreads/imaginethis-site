---
// Sticky concept header at top:0 (global site header is hidden on these pages).
// Left: ImagineThis.Site / Sandy City Inn (concept name larger, both links work)
// Right: Inn · Rooms · Our Town · Visit · About · Stay with us + Sun/Moon toggle (works locally)

const navItems = [
  { href: '/concept/sandy-city-inn/', label: 'Inn' },
  { href: '/concept/sandy-city-inn/rooms/', label: 'Rooms' },
  { href: '/concept/sandy-city-inn/our-town/', label: 'Our Town' },
  { href: '/concept/sandy-city-inn/visit/', label: 'Visit' },
  { href: '/concept/sandy-city-inn/about/', label: 'About' },
];
const currentPath = Astro.url.pathname;
---

<header
  class="sticky top-0 z-40 bg-[var(--sci-cream)]/95 dark:bg-gray-950/70 backdrop-blur-sm border-b border-stone-200/80 dark:border-gray-800"
>
  <div
    class="container-wide h-16 md:h-20 flex items-center justify-between gap-6"
  >
    <!-- Left: breadcrumb with larger concept name -->
    <div class="flex items-baseline gap-3">
      <a
        href="/"
        class="text-xs text-stone-500 dark:text-stone-400 hover:text-stone-800 dark:hover:text-stone-200 transition"
      >
        ImagineThis.Site
      </a>
      <span class="text-stone-300 dark:text-stone-600">/</span>
      <a
        href="/concept/sandy-city-inn/"
        class="font-serif text-2xl md:text-3xl font-semibold tracking-tight text-stone-900 dark:text-white hover:opacity-90 transition"
      >
        Sandy City Inn
      </a>
    </div>

    <!-- Right: nav + theme toggle + CTA -->
    <div class="hidden md:flex items-center gap-6">
      <nav class="flex items-center gap-8" aria-label="Main">
        {
          navItems.map((item) => {
            const isActive =
              currentPath === item.href ||
              (item.href !== '/' && currentPath.startsWith(item.href));
            return (
              <a
                href={item.href}
                class:list={[
                  'text-sm font-medium transition-colors tracking-wide',
                  isActive
                    ? 'text-[var(--sci-forest-800)] dark:text-[var(--sci-cream)]'
                    : 'text-stone-700 dark:text-stone-300 hover:text-[var(--sci-forest-800)] dark:hover:text-[var(--sci-cream)]',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>

      <!-- Sun/Moon toggle (local to this concept header) -->
      <button
        id="sci-theme-toggle"
        type="button"
        class="p-2 rounded-lg hover:bg-stone-200/60 dark:hover:bg-gray-800 transition"
        aria-label="Toggle dark mode"
        aria-pressed="false"
        title="Toggle theme"
      >
        <!-- Sun (shown in dark mode) -->
        <svg
          class="hidden dark:block h-5 w-5 text-yellow-400"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M12 3v2m0 14v2m7.071-13.071-1.414 1.414M6.343 17.657l-1.414 1.414M21 12h-2M5 12H3m13.657 6.657-1.414-1.414M7.757 7.757 6.343 6.343M12 8.25a3.75 3.75 0 1 1 0 7.5 3.75 3.75 0 0 1 0-7.5Z"
          ></path>
        </svg>
        <!-- Moon (shown in light mode) -->
        <svg
          class="block dark:hidden h-5 w-5 text-stone-700 dark:text-stone-300"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79Z"></path>
        </svg>
      </button>

      <a
        href="/concept/sandy-city-inn/visit/"
        class="btn-primary text-sm py-2 px-4"
      >
        Stay with us
      </a>
    </div>

    <!-- Mobile menu button -->
    <button
      id="sci-mobile-menu-toggle"
      type="button"
      class="md:hidden p-2 text-stone-700 dark:text-stone-300"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="sci-mobile-menu"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
      >
        <line x1="4" y1="7" x2="20" y2="7"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="17" x2="20" y2="17"></line>
      </svg>
    </button>
  </div>

  <!-- Mobile panel -->
  <div
    id="sci-mobile-menu"
    class="md:hidden hidden border-t border-stone-200 dark:border-gray-800 bg-[var(--sci-cream)] dark:bg-gray-950"
  >
    <nav class="container-wide py-4 flex flex-col gap-3" aria-label="Mobile">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-base font-medium text-stone-700 dark:text-stone-300 hover:text-[var(--sci-forest-800)] dark:hover:text-[var(--sci-cream)] py-1"
            data-sci-close
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/concept/sandy-city-inn/visit/"
        class="btn-primary text-sm py-2 px-4 mt-2 self-start"
      >
        Stay with us
      </a>
    </nav>
  </div>
</header>

<script>
  (function () {
    // --- Theme toggle (local) ---
    const root = document.documentElement;
    const btn = document.getElementById('sci-theme-toggle');

    function prefersDark() {
      return (
        window.matchMedia &&
        window.matchMedia('(prefers-color-scheme: dark)').matches
      );
    }
    function getSaved() {
      try {
        return localStorage.getItem('theme');
      } catch {
        return null;
      }
    }
    function isDarkNow() {
      const saved = getSaved();
      return saved
        ? saved === 'dark'
        : root.classList.contains('dark') || prefersDark();
    }
    function applyTheme(isDark) {
      root.classList.toggle('dark', isDark);
      if (btn) btn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch {}
    }
    // Initialize
    applyTheme(isDarkNow());
    // Click handler
    if (btn) {
      btn.addEventListener('click', () => {
        const next = !root.classList.contains('dark');
        applyTheme(next);
      });
    }
    // Sync across tabs
    window.addEventListener('storage', (e) => {
      if (e.key === 'theme') applyTheme(e.newValue === 'dark');
    });

    // --- Mobile menu ---
    const toggle = document.getElementById('sci-mobile-menu-toggle');
    const menu = document.getElementById('sci-mobile-menu');
    if (toggle && menu) {
      function closeMenu() {
        menu.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
      }
      function openMenu() {
        menu.classList.remove('hidden');
        toggle.setAttribute('aria-expanded', 'true');
      }
      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        expanded ? closeMenu() : openMenu();
      });
      menu.querySelectorAll('[data-sci-close]').forEach((link) => {
        link.addEventListener('click', closeMenu);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeMenu();
      });
    }
  })();
</script>
