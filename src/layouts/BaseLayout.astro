---
// src/layouts/BaseLayout.astro
import Header from '../components/Header.astro';
import Unpublished from '../components/Unpublished.astro';
import Head from '../components/Head.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  status?: 'draft' | 'published' | 'unpublished';
}

const {
  title = 'ImagineThis.Site',
  description,
  image,
  noindex = false,
  status = 'published',
  ...rest
} = Astro.props;

const isUnpublished = status === 'unpublished';
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Centralized head (icons, OG/Twitter, canonical, etc.) -->
    <Head
      {title}
      {description}
      image={image}
      status={status}
      noindex={noindex}
    />
    <meta name="generator" content={Astro.generator} />
  </head>

  <body>
    {
      isUnpublished ? (
        <Unpublished />
      ) : (
        <>
          <Header />
          <slot />
        </>
      )
    }
  </body>
</html>
