---
// DemoLayout.astro
// Base layout for private concept demo previews
// Includes noindex meta tag to keep demos out of search engines
// Handles page lifecycle states: draft, published, unpublished

import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Unpublished from "../components/Unpublished.astro";

interface Props {
  title?: string;
  description?: string;
  status?: "draft" | "published" | "unpublished";
}

const { 
  title = "Concept Demo - ImagineThis.Site", 
  description = "A private concept demo",
  status = "published",
  ...rest
} = Astro.props;

// Handle page lifecycle
const isUnpublished = status === "unpublished";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="flex flex-col min-h-screen bg-gray-50">
    {isUnpublished ? (
      <Unpublished />
    ) : (
      <>
        <Header />
        <main class="flex-grow">
          <slot />
        </main>
        <Footer />
      </>
    )}
  </body>
</html>
