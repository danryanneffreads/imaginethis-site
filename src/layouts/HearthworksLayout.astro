---
import BaseLayout from './Layout.astro';
const {
  title = 'Hearthworks Architecture',
  description = 'We design places people grow attached to.',
  image,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  noindex={true}
>
  <style is:global>
    @import '/src/styles/hearthworks.css';
  </style>

  <!-- Top concept banner -->
  <div
    role="note"
    class="bg-indigo-50 text-indigo-900 border-b border-indigo-200 px-4 py-2 text-sm text-center"
  >
    This concept demonstrates what a thoughtful website can do for an
    architecture firm.
  </div>

  <!-- Header crumb -->
  <header
    class="bg-white dark:bg-gray-950 sticky top-0 z-40 border-b border-stone-100 dark:border-stone-800"
  >
    <nav
      class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center"
    >
      <div class="flex items-center gap-3">
        <a
          href="/"
          class="text-xs text-gray-500 dark:text-gray-400 hover:text-blue-700 dark:hover:text-blue-300 transition"
        >
          ImagineThis.Site
        </a>
        <span class="text-gray-300 dark:text-gray-600">/</span>
        <a
          href="/concept/hearthworks-architecture/"
          class="text-xl font-serif font-bold text-blue-700 dark:text-blue-300"
        >
          Hearthworks Architecture
        </a>
      </div>
      <div class="hidden sm:flex items-center gap-4 text-sm">
        <a
          href="/#concepts"
          class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white"
          >All concepts</a
        >
        <a
          href="/working-together"
          class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white"
          >Working Together</a
        >
      </div>
    </nav>
  </header>

  <slot />

  <!-- Subtle reminder -->
  <footer class="mt-16 border-t border-gray-200 dark:border-gray-800">
    <div
      class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-6 text-sm text-gray-600 dark:text-gray-400"
    >
      Fictional projects for demonstration. Inspired by real neighborhoods.
    </div>
  </footer>
</BaseLayout>
