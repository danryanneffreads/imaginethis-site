---
import '@/styles/global.css';
import '@/styles/hrh.css';

export interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Sleep, movement, nutrition, light, environment, and relationships—woven into simple weekly rhythms.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:wght@400;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark =
            window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: dark)').matches;
          const useDark = stored ? stored === 'dark' : prefersDark;
          document.documentElement.classList.toggle('dark', useDark);
        } catch (_) {}
      })();
    </script>
  </head>

  <body
    class="flex flex-col min-h-screen bg-white dark:bg-gray-950 dark:text-white"
    style="font-family: Inter, system-ui, sans-serif"
  >
    <!-- Concept Site Banner -->
    <div
      role="note"
      class="bg-indigo-50 text-indigo-900 border-b border-indigo-200 px-4 py-2 text-sm text-center"
    >
      This concept demonstrates what a thoughtful health and wellness website
      can do.
    </div>

    <!-- Header -->
    <header
      class="bg-white/90 dark:bg-gray-950/70 backdrop-blur sticky top-0 z-50 border-b border-stone-100 dark:border-gray-800"
    >
      <nav
        class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center"
      >
        <div class="flex items-center gap-4">
          <a
            href="/"
            class="text-xs text-gray-500 dark:text-gray-400 hover:text-teal-700 dark:hover:text-teal-400 transition"
          >
            ImagineThis.Site
          </a>
          <span class="text-gray-300 dark:text-gray-600">/</span>
          <a
            href="/concept/human-rhythm-health/"
            class="text-2xl font-serif font-bold hover:opacity-90 transition"
            style="color: var(--hrh-forest)"
          >
            Human Rhythm Health
          </a>
        </div>

        <div class="flex items-center gap-3">
          <ul
            class="hidden md:flex gap-6 text-gray-700 dark:text-gray-300 items-center"
          >
            <li>
              <a
                href="/concept/human-rhythm-health/"
                class="hover:text-teal-700 dark:hover:text-teal-400 transition font-medium"
                >Home</a
              >
            </li>
            <li>
              <a
                href="/concept/human-rhythm-health/programs/"
                class="hover:text-teal-700 dark:hover:text-teal-400 transition font-medium"
                >Programs</a
              >
            </li>
            <li>
              <a
                href="/concept/human-rhythm-health/studio/"
                class="hover:text-teal-700 dark:hover:text-teal-400 transition font-medium"
                >Studio</a
              >
            </li>
            <li>
              <a
                href="/concept/human-rhythm-health/about/"
                class="hover:text-teal-700 dark:hover:text-teal-400 transition font-medium"
                >About</a
              >
            </li>
            <li>
              <a
                href="/concept/human-rhythm-health/contact/"
                class="hover:text-teal-700 dark:hover:text-teal-400 transition font-medium"
                >Contact</a
              >
            </li>
          </ul>

          <button
            id="theme-toggle"
            type="button"
            class="p-2 rounded-lg hover:bg-stone-100 dark:hover:bg-gray-800 transition"
            aria-label="Toggle dark mode"
            title="Toggle dark mode"
          >
            <svg
              class="hidden dark:block"
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.364 6.364-1.414-1.414M7.05 7.05 5.636 5.636m12.728 0L17.95 7.05M7.05 16.95l-1.414 1.414M12 8.25a3.75 3.75 0 1 1 0 7.5 3.75 3.75 0 0 1 0-7.5Z"
              ></path>
            </svg>

            <svg
              class="block dark:hidden"
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
            </svg>
          </button>
        </div>
      </nav>

      <div class="hrh-accent"></div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-auto border-t border-stone-100 dark:border-gray-800">
      <div
        class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 text-sm text-gray-600 dark:text-gray-400"
      >
        © {new Date().getFullYear()} Human Rhythm Health — Example concept by ImagineThis.Site
      </div>
    </footer>

    <script is:inline>
      const btn = document.getElementById('theme-toggle');
      if (btn) {
        btn.addEventListener('click', () => {
          const root = document.documentElement;
          const nowDark = root.classList.toggle('dark');
          try {
            localStorage.setItem('theme', nowDark ? 'dark' : 'light');
          } catch (_) {}
        });
      }
    </script>
  </body>
</html>
