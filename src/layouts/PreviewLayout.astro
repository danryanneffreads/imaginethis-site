---
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/Hero.astro';

const {
  title = "Preview",
  eyebrow = "ImagineThis Preview",
  description = ""
} = Astro.props;
---

<BaseLayout title={title}>
  <Hero
    eyebrow={eyebrow}
    title={title}
    description={description}
  />

  <slot />
</BaseLayout>