---
import Layout from "./Layout.astro";

interface Props {
  title?: string;
  description?: string;
  business?: string;  // Optional label in the banner
  banner?: boolean;   // Set to false to hide the banner
}

const {
  title = "Private Preview",
  description = "",
  business = "Private Client",
  banner = true
} = Astro.props;
---

<Layout title={title} description={description} noindex={true}>
  {banner && (
    <div class="bg-amber-100 text-amber-900 border-b border-amber-300 px-4 py-2 text-sm">
      <div class="mx-auto max-w-7xl">
        <strong>Private preview{business ? ` — ${business}` : ""}.</strong>
        Not for public distribution. This page is unlisted and noindexed.
      </div>
    </div>
  )}
  <slot />
</Layout>
