---
// src/layouts/SyncCoffeeLayout.astro
export interface Props {
  title: string;
  description?: string;
  image?: string;
  status?: 'draft' | 'published' | 'unpublished';
  noindex?: boolean;
}

import Head from '../components/Head.astro';
import '../styles/global.css'; // Pulls in Tailwind and site styles

const {
  title,
  description,
  image,
  status = 'published',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Ensure correct character encoding FIRST -->
    <meta charset="utf-8" />
    <!-- Defensive: some agents still honor this when headers omit charset -->
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />

    <!-- Ensure correct mobile scaling -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <!-- Let the UA know we support dark color scheme -->
    <meta name="color-scheme" content="light dark" />

    <!-- Centralized head (icons, OG/Twitter, canonical, etc.) -->
    <Head
      {title}
      {description}
      image={image}
      status={status}
      noindex={noindex}
    />

    <!-- Set initial theme early to avoid flash (kept) -->
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem('theme');
          if (
            saved === 'dark' ||
            (!saved &&
              window.matchMedia &&
              window.matchMedia('(prefers-color-scheme: dark)').matches)
          ) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body
    class="min-h-screen bg-white text-gray-900 antialiased dark:bg-gray-950 dark:text-gray-100"
  >
    <!-- Concept Site Banner -->
    <div
      role="note"
      class="bg-indigo-50 text-indigo-900 border-b border-indigo-200 px-4 py-2 text-sm text-center"
    >
      This concept demonstrates what a thoughtful website can do for a coffee
      shop.
    </div>
    <!-- Skip link -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-blue-700 focus:px-3 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <!-- Site Header -->
    <header
      class="bg-white dark:bg-gray-950 sticky top-0 z-50 border-b border-stone-100 dark:border-blue-900"
    >
      <nav
        class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center"
      >
        <div class="flex items-center gap-4">
          <a
            href="/"
            class="text-xs text-gray-500 dark:text-gray-400 hover:text-blue-700 dark:hover:text-blue-300 transition"
          >
            ImagineThis.Site
          </a>
          <span class="text-gray-300 dark:text-gray-600">/</span>
          <a
            href="/concept/sync-coffee/"
            class="text-2xl font-serif font-bold text-blue-700 dark:text-blue-300"
          >
            Synchronize Coffee
          </a>
        </div>

        <div class="flex items-center gap-3">
          <ul
            class="hidden md:flex gap-6 text-gray-700 dark:text-gray-300 items-center"
          >
            <li>
              <a
                href="/concept/sync-coffee/"
                class="hover:text-blue-800 dark:hover:text-blue-200 transition font-medium"
                >Home</a
              >
            </li>
            <li>
              <a
                href="/concept/sync-coffee/menu/"
                class="hover:text-blue-800 dark:hover:text-blue-200 transition font-medium"
                >Menu</a
              >
            </li>
            <li>
              <a
                href="/concept/sync-coffee/about/"
                class="hover:text-blue-800 dark:hover:text-blue-200 transition font-medium"
                >About</a
              >
            </li>
            <li>
              <a
                href="/concept/sync-coffee/contact/"
                class="hover:text-blue-800 dark:hover:text-blue-200 transition font-medium"
                >Contact</a
              >
            </li>
          </ul>

          <!-- Global Dark/Light toggle -->
          <button
            id="theme-toggle"
            type="button"
            class="p-2 rounded-lg hover:bg-stone-100 dark:hover:bg-gray-800 transition"
            aria-label="Toggle dark mode"
            title="Toggle dark mode"
          >
            <!-- Sun (shows in dark mode) -->
            <svg
              class="w-5 h-5 hidden dark:block text-amber-300"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.364 6.364-1.414-1.414M7.05 7.05 5.636 5.636m12.728 0L17.95 7.05M7.05 16.95l-1.414 1.414M12 8.25a3.75 3.75 0 1 1 0 7.5 3.75 3.75 0 0 1 0-7.5Z"
              ></path>
            </svg>
            <!-- Moon (shows in light mode) -->
            <svg
              class="w-5 h-5 block dark:hidden text-gray-700"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <!-- Page Content -->
    <main id="main">
      <slot />
    </main>

    <!-- Site Footer -->
    <footer class="bg-blue-900 dark:bg-blue-950 text-white py-12 mt-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
          <div>
            <h3 class="font-serif text-lg font-bold mb-4">
              Synchronize Coffee
            </h3>
            <p class="text-stone-100/90 text-sm">
              A community third space where art, coffee, and connection
              flourish.
            </p>
          </div>
          <div>
            <h4 class="font-semibold mb-4">Quick Links</h4>
            <ul class="space-y-2 text-sm text-stone-100/90">
              <li>
                <a
                  href="/concept/sync-coffee/"
                  class="hover:text-amber-300 transition">Home</a
                >
              </li>
              <li>
                <a
                  href="/concept/sync-coffee/menu/"
                  class="hover:text-amber-300 transition">Menu</a
                >
              </li>
              <li>
                <a
                  href="/concept/sync-coffee/about/"
                  class="hover:text-amber-300 transition">About</a
                >
              </li>
              <li>
                <a
                  href="/concept/sync-coffee/contact/"
                  class="hover:text-amber-300 transition">Contact</a
                >
              </li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold mb-4">Follow</h4>
            <ul class="space-y-2 text-sm text-stone-100/90">
              <li>
                <a href="#" class="hover:text-orange-300 transition"
                  >Instagram</a
                >
              </li>
              <li>
                <a href="#" class="hover:text-orange-300 transition">Twitter</a>
              </li>
            </ul>
          </div>
        </div>
        <p class="text-xs text-stone-200/70">© Synchronize Coffee</p>
      </div>
    </footer>

    <!-- Toggle logic: persists globally via localStorage('theme') -->
    <script is:inline>
      (function () {
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        btn.addEventListener('click', () => {
          const root = document.documentElement;
          const next = root.classList.toggle('dark') ? 'dark' : 'light';
          try {
            localStorage.setItem('theme', next);
          } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
