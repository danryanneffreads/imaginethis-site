---
// SyncCoffeeLayout.astro
// Layout for Synchronize Coffee — warm, artsy, community-focused
// Color scheme: warm greens, natural wood tones, clean minimal design inspired by NKORA

import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Synchronize Coffee - Community Third Space",
  description = "Synchronize Coffee — where community gathers, art is displayed, and good coffee fuels connection."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      :root {
        --font-serif: 'Lora', serif;
        --font-sans: 'Inter', sans-serif;
        --color-sage: #6B8B6B;
        --color-sage-dark: #4A5E4A;
        --color-sage-light: #8FA88F;
        --color-cream: #F7F5F1;
        --color-wood: #8B7355;
      }
    </style>
  </head>
  <body class="flex flex-col min-h-screen bg-white dark:bg-gray-950 dark:text-white" style="font-family: var(--font-sans)">
    <header class="bg-white dark:bg-gray-950 dark:border-gray-800 sticky top-0 z-50 border-b border-emerald-100 dark:border-emerald-900">
      <!-- Breadcrumb/Back link -->
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-2 text-sm text-gray-600 dark:text-gray-400">
        <a href="/" class="hover:text-emerald-700 dark:hover:text-emerald-400 transition">← Back to ImagineThis.Site</a>
      </div>
      
      <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex justify-between items-center">
        <div class="flex items-center">
          <a href="/sync-coffee/" class="text-2xl font-serif font-bold text-emerald-800 dark:text-emerald-400">Synchronize Coffee</a>
        </div>
        <ul class="hidden md:flex gap-8 text-gray-700 dark:text-gray-300 items-center">
          <li><a href="/sync-coffee/" class="hover:text-emerald-700 dark:hover:text-emerald-400 transition font-medium">Home</a></li>
          <li><a href="/sync-coffee/menu/" class="hover:text-emerald-700 dark:hover:text-emerald-400 transition font-medium">Menu</a></li>
          <li><a href="/sync-coffee/about/" class="hover:text-emerald-700 dark:hover:text-emerald-400 transition font-medium">About</a></li>
          <li><a href="/sync-coffee/contact/" class="hover:text-emerald-700 dark:hover:text-emerald-400 transition font-medium">Contact</a></li>
          <li>
            <button id="darkModeToggle" class="p-2 hover:bg-gray-100 dark:hover:bg-gray-800 rounded transition" aria-label="Toggle dark mode">
              <span id="sunIcon" class="inline dark:hidden">☀️</span>
              <span id="moonIcon" class="hidden dark:inline">🌙</span>
            </button>
          </li>
        </ul>
      </nav>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="bg-emerald-900 dark:bg-emerald-950 text-white py-12 mt-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
          <div>
            <h3 class="font-serif text-lg font-bold mb-4">Synchronize Coffee</h3>
            <p class="text-emerald-100 text-sm">A community third space where art, coffee, and connection flourish.</p>
          </div>
          <div>
            <h4 class="font-semibold mb-4">Quick Links</h4>
            <ul class="space-y-2 text-sm text-emerald-100">
              <li><a href="/sync-coffee/" class="hover:text-white transition">Home</a></li>
              <li><a href="/sync-coffee/menu/" class="hover:text-white transition">Menu</a></li>
              <li><a href="/sync-coffee/about/" class="hover:text-white transition">About</a></li>
              <li><a href="/sync-coffee/contact/" class="hover:text-white transition">Contact</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold mb-4">Follow</h4>
            <ul class="space-y-2 text-sm text-emerald-100">
              <li><a href="#" class="hover:text-white transition">Instagram</a></li>
              <li><a href="#" class="hover:text-white transition">Twitter</a></li>
              <li><a href="#" class="hover:text-white transition">Facebook</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-emerald-800 pt-8 text-center text-sm text-emerald-200">
          <p>Concept demo by <a href="/" class="hover:text-white transition underline">ImagineThis.Site</a> — not a real website</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Dark mode toggle functionality - runs inline for immediate availability
      (function() {
        function initToggle() {
          const toggle = document.getElementById('darkModeToggle');
          const html = document.documentElement;

          if (!toggle) return;

          toggle.addEventListener('click', function(e) {
            e.preventDefault();
            const isDark = html.classList.contains('dark');
            if (isDark) {
              html.classList.remove('dark');
              localStorage.setItem('darkMode', 'false');
            } else {
              html.classList.add('dark');
              localStorage.setItem('darkMode', 'true');
            }
          });
        }

        // Run immediately if DOM is ready, otherwise wait
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initToggle);
        } else {
          initToggle();
        }
      })();
    </script>
  </body>
</html>
