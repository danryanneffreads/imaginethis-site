---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';

const title = 'Page Not Found - ImagineThis.Site';
const description = 'The page you’re looking for isn’t here.';
---

<Layout title={title} description={description} noindex={true}>
  <section class="py-24">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <p
        class="text-sm tracking-wider text-gray-500 dark:text-gray-400 uppercase mb-3"
      >
        404
      </p>
      <h1 class="text-4xl md:text-5xl font-serif font-bold mb-4">
        Page not found
      </h1>
      <p class="text-gray-700 dark:text-gray-300 mb-8">
        The page you requested doesn’t exist or has moved.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/"
          class="inline-block px-5 py-3 rounded-md bg-gray-900 text-white dark:bg-white dark:text-gray-900"
        >
          Back to home
        </a>
        <a
          href="/#concepts"
          class="inline-block px-5 py-3 rounded-md border border-gray-300 dark:border-gray-700 text-gray-900 dark:text-white"
        >
          See concepts
        </a>
      </div>
    </div>
  </section>
</Layout>
