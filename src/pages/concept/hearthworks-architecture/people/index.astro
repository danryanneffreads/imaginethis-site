---
import HearthworksLayout from '../../../../layouts/HearthworksLayout.astro';
import { people } from '../../../../data/hearthworks-people';
import PeopleCard from '../../../../components/hearthworks/PeopleCard.astro';
---

<HearthworksLayout
  title="People — Hearthworks Architecture"
  description="The people behind Hearthworks Architecture."
>
  <section
    class="py-10 border-b border-stone-200 dark:border-stone-800 bg-white/60 dark:bg-gray-950/60"
  >
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-serif font-bold">People</h1>
      <p class="text-gray-700 dark:text-gray-300 mt-2 max-w-2xl">
        A small team focused on homes, neighborhood buildings, libraries,
        workplaces, and community spaces.
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {people.map((p) => <PeopleCard person={p} />)}
      </div>
    </div>
  </section>
</HearthworksLayout>
