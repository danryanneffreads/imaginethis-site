---
import HearthworksLayout from '../../../../layouts/HearthworksLayout.astro';
import PhotoCard from '../../../../components/hearthworks/PhotoCard.astro';
import { projects, enums } from '../../../../data/hearthworks-projects';

const typeOptions = enums.types;
const spaceOptions = enums.spaces;
const materialOptions = enums.materials;

// Build a flat list of all photos across projects, including hero (marked as Cover).
// Avoid duplicates if the hero already exists in the gallery.
const photos = projects.flatMap((p) => {
  const galleryItems = p.gallery.map((g) => ({
    src: g.src,
    alt: g.alt,
    projectSlug: p.slug,
    projectTitle: p.title,
    projectType: p.type,
    spaces: g.spaces,
    materials: g.materials,
    isCover: false,
    kind: 'detail',
  }));
  const heroAlreadyInGallery = p.gallery.some((g) => g.src === p.hero);
  const heroItem = heroAlreadyInGallery
    ? []
    : [
        {
          src: p.hero,
          alt: `${p.title} — cover`,
          projectSlug: p.slug,
          projectTitle: p.title,
          projectType: p.type,
          spaces: p.spaces,
          materials: p.materials,
          isCover: true,
          kind: 'cover',
        },
      ];
  return [...heroItem, ...galleryItems];
});
---

<HearthworksLayout
  title="Portfolio — Hearthworks Architecture"
  description="Browse every photo. Filter by project type, space, and material."
>
  <!-- Header with subtle background image -->
  <section
    class="py-10 border-b border-stone-200 dark:border-stone-800 bg-white/80 dark:bg-gray-950/70 hw-portfolio-hero"
  >
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between gap-4">
        <div>
          <h1 class="text-3xl font-serif font-bold mb-1">Portfolio</h1>
          <p class="text-gray-700 dark:text-gray-300 max-w-2xl">
            Browse every photo. Filter by project type, space, and material. Use
            “Cover photos only” to skim one image per project.
          </p>
        </div>

        <!-- Photo type control -->
        <div
          class="inline-flex items-center rounded-md border border-stone-200 dark:border-stone-800 overflow-hidden"
        >
          <button
            id="kindAll"
            class="px-3 py-2 text-sm bg-white dark:bg-gray-900 text-gray-900 dark:text-white"
            aria-pressed="true">All photos</button
          >
          <button
            id="kindCover"
            class="px-3 py-2 text-sm bg-transparent text-gray-700 dark:text-gray-300"
            aria-pressed="false">Cover photos only</button
          >
          <button
            id="kindDetail"
            class="px-3 py-2 text-sm bg-transparent text-gray-700 dark:text-gray-300"
            aria-pressed="false">Detail photos only</button
          >
        </div>
      </div>

      <!-- Filters -->
      <div id="filters" class="mt-6 space-y-4">
        <div>
          <p
            class="text-sm font-semibold text-gray-800 dark:text-gray-200 mb-2"
          >
            Project Type
          </p>
          <div class="flex flex-wrap gap-2" id="facet-type">
            {
              typeOptions.map((opt) => (
                <label class="hw-chip cursor-pointer select-none">
                  <input
                    type="checkbox"
                    class="sr-only"
                    value={opt}
                    data-facet="type"
                    aria-label={opt}
                  />
                  <span>{opt}</span>
                </label>
              ))
            }
          </div>
        </div>

        <div>
          <p
            class="text-sm font-semibold text-gray-800 dark:text-gray-200 mb-2"
          >
            Space
          </p>
          <div class="flex flex-wrap gap-2" id="facet-space">
            {
              spaceOptions.map((opt) => (
                <label class="hw-chip cursor-pointer select-none">
                  <input
                    type="checkbox"
                    class="sr-only"
                    value={opt}
                    data-facet="space"
                    aria-label={opt}
                  />
                  <span>{opt}</span>
                </label>
              ))
            }
          </div>
        </div>

        <div>
          <p
            class="text-sm font-semibold text-gray-800 dark:text-gray-200 mb-2"
          >
            Material
          </p>
          <div class="flex flex-wrap gap-2" id="facet-material">
            {
              materialOptions.map((opt) => (
                <label class="hw-chip cursor-pointer select-none">
                  <input
                    type="checkbox"
                    class="sr-only"
                    value={opt}
                    data-facet="material"
                    aria-label={opt}
                  />
                  <span>{opt}</span>
                </label>
              ))
            }
          </div>
        </div>

        <!-- Active filters ribbon (auto-hides when empty) -->
        <div id="activeBar" class="hw-activebar mt-3"></div>

        <div class="flex items-center gap-4 mt-3">
          <button id="clearAll" class="hw-clear">Clear all</button>
          <span id="count" class="text-sm text-gray-700 dark:text-gray-300"
            >Showing {photos.length} photos</span
          >
        </div>
      </div>
    </div>
  </section>

  <!-- Results: photos grid only -->
  <section class="py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        id="results-photos"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
      >
        {
          photos.map((ph) => (
            <div
              class="photo-card"
              data-kind={ph.kind}
              data-type={ph.projectType}
              data-spaces={ph.spaces.join('|')}
              data-materials={ph.materials.join('|')}
            >
              <PhotoCard photo={ph} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <script is:inline>
    // Photos-only portfolio with "Photo type" control (kind=all|cover|detail)
    (() => {
      const filtersRoot = document.getElementById('filters');
      const checkboxes = Array.from(
        document.querySelectorAll('input[type="checkbox"][data-facet]')
      );
      const activeBar = document.getElementById('activeBar');
      const countEl = document.getElementById('count');
      const cards = Array.from(
        document.querySelectorAll('#results-photos .photo-card')
      );

      const btnAll = document.getElementById('kindAll');
      const btnCover = document.getElementById('kindCover');
      const btnDetail = document.getElementById('kindDetail');
      const clearAllBtn = document.getElementById('clearAll');

      function getKindFromURL() {
        const q = new URLSearchParams(location.search);
        const k = q.get('kind');
        return k === 'cover' || k === 'detail' ? k : 'all';
      }

      function setKindToURL(kind) {
        const next = new URL(location.href);
        next.searchParams.set('kind', kind);
        // keep current filter params
        const state = getState();
        ['type', 'space', 'material'].forEach((k) =>
          next.searchParams.delete(k)
        );
        Object.entries(state).forEach(([k, arr]) =>
          arr.forEach((v) => next.searchParams.append(k, v))
        );
        history.replaceState(null, '', next.toString());
      }

      function styleKind(kind) {
        const active =
          'px-3 py-2 text-sm bg-white dark:bg-gray-900 text-gray-900 dark:text-white';
        const inactive =
          'px-3 py-2 text-sm bg-transparent text-gray-700 dark:text-gray-300';
        btnAll?.setAttribute('class', kind === 'all' ? active : inactive);
        btnAll?.setAttribute('aria-pressed', kind === 'all' ? 'true' : 'false');
        btnCover?.setAttribute('class', kind === 'cover' ? active : inactive);
        btnCover?.setAttribute(
          'aria-pressed',
          kind === 'cover' ? 'true' : 'false'
        );
        btnDetail?.setAttribute('class', kind === 'detail' ? active : inactive);
        btnDetail?.setAttribute(
          'aria-pressed',
          kind === 'detail' ? 'true' : 'false'
        );
      }

      function getState() {
        const checked = checkboxes.filter((cb) => cb.checked);
        return {
          type: checked
            .filter((cb) => cb.dataset.facet === 'type')
            .map((cb) => cb.value),
          space: checked
            .filter((cb) => cb.dataset.facet === 'space')
            .map((cb) => cb.value),
          material: checked
            .filter((cb) => cb.dataset.facet === 'material')
            .map((cb) => cb.value),
        };
      }

      function matches(el, kind, state) {
        const elKind = el.getAttribute('data-kind'); // cover | detail
        if (kind === 'cover' && elKind !== 'cover') return false;
        if (kind === 'detail' && elKind !== 'detail') return false;

        const type = el.getAttribute('data-type');
        const spaces = (el.getAttribute('data-spaces') || '')
          .split('|')
          .filter(Boolean);
        const materials = (el.getAttribute('data-materials') || '')
          .split('|')
          .filter(Boolean);
        const typeOK = state.type.length ? state.type.includes(type) : true;
        const spaceOK = state.space.length
          ? state.space.some((s) => spaces.includes(s))
          : true;
        const materialOK = state.material.length
          ? state.material.some((m) => materials.includes(m))
          : true;
        return typeOK && spaceOK && materialOK;
      }

      function renderActiveBar(state) {
        const active = [
          ...state.type.map((v) => ({ facet: 'type', value: v })),
          ...state.space.map((v) => ({ facet: 'space', value: v })),
          ...state.material.map((v) => ({ facet: 'material', value: v })),
        ];
        if (active.length === 0) {
          activeBar.style.display = 'none';
          activeBar.innerHTML = '';
          return;
        }
        activeBar.style.display = '';
        activeBar.innerHTML = `
          <div class="flex flex-wrap items-center gap-2">
            ${active
              .map(
                (
                  a
                ) => `<button class="hw-chip hw-chip--activebar" data-remove-facet="${a.facet}" data-remove-value="${a.value}" aria-label="Remove ${a.value}">
              ${a.value}<span class="hw-x" aria-hidden="true">×</span>
            </button>`
              )
              .join('')}
            <button id="barClear" class="hw-clear" aria-label="Clear all filters">Clear all</button>
          </div>
        `;
        activeBar.querySelectorAll('[data-remove-facet]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const facet = btn.getAttribute('data-remove-facet');
            const value = btn.getAttribute('data-remove-value');
            const cb = document.querySelector(
              'input[type="checkbox"][data-facet="' +
                facet +
                '"][value="' +
                value +
                '"]'
            );
            if (cb) {
              cb.checked = false;
              update();
            }
          });
        });
        const barClear = document.getElementById('barClear');
        if (barClear)
          barClear.addEventListener('click', (e) => {
            e.preventDefault();
            clearAll();
          });
      }

      function renderResults(kind, state) {
        let visible = 0;
        let coversVisible = 0;
        cards.forEach((el) => {
          const ok = matches(el, kind, state);
          el.style.display = ok ? '' : 'none';
          if (ok) {
            visible++;
            if (el.getAttribute('data-kind') === 'cover') coversVisible++;
          }
        });
        if (countEl) {
          if (kind === 'all') {
            countEl.textContent = `Showing ${visible} photos (${coversVisible} covers)`;
          } else if (kind === 'cover') {
            countEl.textContent = `Showing ${visible} project covers`;
          } else {
            countEl.textContent = `Showing ${visible} photos`;
          }
        }
      }

      function updateURL(kind, state) {
        const next = new URL(location.href);
        next.searchParams.set('kind', kind);
        ['type', 'space', 'material'].forEach((k) =>
          next.searchParams.delete(k)
        );
        Object.entries(state).forEach(([k, arr]) =>
          arr.forEach((v) => next.searchParams.append(k, v))
        );
        history.replaceState(null, '', next.toString());
      }

      function update() {
        const kind = getKindFromURL();
        const state = getState();
        styleKind(kind);
        updateURL(kind, state);
        renderResults(kind, state);
        renderActiveBar(state);
      }

      function clearAll() {
        checkboxes.forEach((cb) => {
          cb.checked = false;
        });
        update();
      }

      // Initialize from URL
      (function initFromURL() {
        const q = new URLSearchParams(location.search);
        const kind =
          q.get('kind') === 'cover' || q.get('kind') === 'detail'
            ? q.get('kind')
            : 'all';
        styleKind(kind || 'all');
        ['type', 'space', 'material'].forEach((facet) => {
          const selected = new Set(q.getAll(facet));
          checkboxes
            .filter((cb) => cb.dataset.facet === facet)
            .forEach((cb) => {
              cb.checked = selected.has(cb.value);
            });
        });
        update();
      })();

      // Kind control
      btnAll?.addEventListener('click', (e) => {
        e.preventDefault();
        setKindToURL('all');
        update();
      });
      btnCover?.addEventListener('click', (e) => {
        e.preventDefault();
        setKindToURL('cover');
        update();
      });
      btnDetail?.addEventListener('click', (e) => {
        e.preventDefault();
        setKindToURL('detail');
        update();
      });

      // Event delegation for label clicks
      filtersRoot?.addEventListener('click', (e) => {
        const target = e.target instanceof Element ? e.target : null;
        const label = target ? target.closest('label.hw-chip') : null;
        if (!label) return;
        const cb = label.querySelector('input[type="checkbox"]');
        if (!cb) return;
        e.preventDefault();
        cb.checked = !cb.checked;
        update();
      });

      // For keyboard/assistive tech
      filtersRoot?.addEventListener('change', (e) => {
        const t = e.target;
        if (t && t.matches && t.matches('input[type="checkbox"][data-facet]'))
          update();
      });

      clearAllBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        clearAll();
      });
    })();
  </script>
</HearthworksLayout>
