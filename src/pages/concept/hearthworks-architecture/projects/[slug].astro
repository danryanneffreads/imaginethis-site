---
import HearthworksLayout from '../../../../layouts/HearthworksLayout.astro';
import type { Project } from '../../../../data/hearthworks-projects';
import { projects, isElsewhere } from '../../../../data/hearthworks-projects';

// We want this route to be statically generated for each project
export const prerender = true;

// Tell Astro which pages to build and pass the project as props
export async function getStaticPaths() {
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

// Receive the project via props from getStaticPaths
const { project } = Astro.props as { project: Project };
const elsewhere = isElsewhere(project.location);
---

<HearthworksLayout
  title={`${project.title} — Hearthworks Architecture`}
  description={project.summary}
  image={project.hero}
>
  <section class="py-10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <p
        class="text-sm tracking-wider text-gray-500 dark:text-gray-400 uppercase mb-2"
      >
        Project
      </p>
      <h1
        class="text-3xl md:text-4xl font-serif font-bold text-gray-900 dark:text-white"
      >
        {project.title}
      </h1>
      <div
        class="mt-2 flex items-center gap-3 text-gray-700 dark:text-gray-300"
      >
        <span>{project.location}</span>
        <span aria-hidden="true">•</span>
        <span>{project.type}</span>
        {elsewhere && <span class="hw-chip hw-elsewhere">Elsewhere</span>}
      </div>
      <img
        src={project.hero}
        alt={project.title}
        class="mt-6 w-full h-80 object-cover rounded-lg border border-stone-200 dark:border-stone-800"
      />

      <div class="mt-8 grid md:grid-cols-3 gap-6">
        <div class="md:col-span-2 space-y-5">
          <p class="text-gray-800 dark:text-gray-200">{project.summary}</p>

          <h2 class="text-xl font-semibold mt-6">Neighborhood & site</h2>
          <p class="text-gray-700 dark:text-gray-300">
            Set within a walkable block, the project takes cues from its
            neighbors—porches, brick bases, street trees, and planted edges.
          </p>

          <h2 class="text-xl font-semibold">Everyday use</h2>
          <p class="text-gray-700 dark:text-gray-300">
            Spaces are tuned to daily routines—welcoming entries, workable
            kitchens and offices, and outdoor rooms that extend life into
            gardens and courtyards.
          </p>

          <h2 class="text-xl font-semibold">Materials & craft</h2>
          <p class="text-gray-700 dark:text-gray-300">
            Durable, repairable materials—{
              project.materials.slice(0, 3).join(', ')
            }—are detailed for touch and longevity.
          </p>
        </div>

        <aside>
          <div
            class="rounded-lg border border-stone-200 dark:border-stone-800 p-4 bg-white/70 dark:bg-gray-900/40"
          >
            <h3 class="font-semibold mb-2">Project info</h3>
            <ul class="text-sm text-gray-700 dark:text-gray-300 space-y-1">
              <li><strong>Type:</strong> {project.type}</li>
              <li><strong>Location:</strong> {project.location}</li>
              <li><strong>Spaces:</strong> {project.spaces.join(', ')}</li>
              <li>
                <strong>Materials:</strong>
                {project.materials.join(', ')}
              </li>
            </ul>
          </div>
        </aside>
      </div>

      <div class="mt-10">
        <h2 class="text-2xl font-serif font-semibold mb-4">Gallery</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {
            project.gallery.map((g) => (
              <figure class="rounded-lg overflow-hidden border border-stone-200 dark:border-stone-800 bg-white/70 dark:bg-gray-900/40">
                <img
                  src={g.src}
                  alt={g.alt}
                  class="w-full h-64 object-cover"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption class="p-3 text-sm text-gray-700 dark:text-gray-300">
                  {g.alt}
                  <span class="block mt-1 text-xs text-gray-500 dark:text-gray-400">
                    {g.spaces.join(' · ')} • {g.materials.join(' · ')}
                  </span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>

      <div class="mt-10">
        <a
          href="/concept/hearthworks-architecture/portfolio/"
          class="text-blue-700 dark:text-blue-300 hover:underline"
          >← Back to portfolio</a
        >
      </div>
    </div>
  </section>
</HearthworksLayout>
