---
import '@/styles/global.css';
import '@/styles/hrh.css';
status: "published";
const isExample = Astro.url?.pathname?.startsWith("/concept/");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>About — Human Rhythm Health</title>
    <meta name="description" content="Human Rhythm Health helps people align sleep, movement, meals, light, environment, and relationships into simple weekly rhythms." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Initial theme (dark/light) -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          const useDark = stored ? stored === 'dark' : prefersDark;
          document.documentElement.classList.toggle('dark', useDark);
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="bg-white dark:bg-gray-950 dark:text-white" style="font-family: Inter, system-ui, sans-serif">
    {isExample && (
      <div class="bg-indigo-50 text-indigo-900 border-b border-indigo-200 px-4 py-2 text-sm text-center">
        Example concept site (public showcase)
      </div>
    )}

    <!-- Header -->
    <header class="bg-white/90 dark:bg-gray-950/70 backdrop-blur sticky top-0 z-50 border-b border-stone-100 dark:border-gray-800">
      <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
        <div class="flex items-center gap-4">
          <a href="/" class="text-xs text-gray-500 dark:text-gray-400 hover:text-teal-700 dark:hover:text-teal-400 transition">ImagineThis.Site</a>
          <span class="text-gray-300 dark:text-gray-600">/</span>
          <a href="/concept/human-rhythm-health/" class="text-2xl font-serif font-bold hover:opacity-90 transition" style="color: var(--hrh-forest)">Human Rhythm Health</a>
        </div>
        <div class="flex items-center gap-3">
          <ul class="hidden md:flex gap-6 text-gray-700 dark:text-gray-300 items-center">
            <li><a href="/concept/human-rhythm-health/" class="hover:text-teal-700 dark:hover:text-teal-400 transition font-medium">Home</a></li>
            <li><a href="/concept/human-rhythm-health/programs/" class="hover:text-teal-700 dark:hover:text-teal-400 transition font-medium">Programs</a></li>
            <li><a href="/concept/human-rhythm-health/studio/" class="hover:text-teal-700 dark:hover:text-teal-400 transition font-medium">Studio</a></li>
            <li><a href="/concept/human-rhythm-health/about/" class="text-teal-700 dark:text-teal-400 font-semibold">About</a></li>
            <li><a href="/concept/human-rhythm-health/contact/" class="hover:text-teal-700 dark:hover:text-teal-400 transition font-medium">Contact</a></li>
          </ul>

          <!-- Dark mode toggle -->
          <button
            id="theme-toggle"
            type="button"
            class="p-2 rounded-lg hover:bg-stone-100 dark:hover:bg-gray-800 transition"
            aria-label="Toggle dark mode"
            title="Toggle dark mode"
          >
            <!-- Sun (shows in dark mode) -->
            <svg class="hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.364 6.364-1.414-1.414M7.05 7.05 5.636 5.636m12.728 0L17.95 7.05M7.05 16.95l-1.414 1.414M12 8.25a3.75 3.75 0 1 1 0 7.5 3.75 3.75 0 0 1 0-7.5Z"/>
            </svg>
            <!-- Moon (shows in light mode) -->
            <svg class="block dark:hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/>
            </svg>
          </button>
        </div>
      </nav>
      <div class="hrh-accent"></div>
    </header>

    <!-- Textured hero -->
    <section class="relative py-16">
      <img src="/images/health/botanical-textures2.webp" alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover -z-10" />
      <div class="absolute inset-0 -z-10 bg-white/85 dark:bg-gray-950/70"></div>
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl font-serif font-bold text-gray-900 dark:text-white">About</h1>
        <p class="mt-3 max-w-2xl text-gray-700 dark:text-gray-300">
          We help you build simple, durable habits by aligning with the body’s natural clocks.
        </p>
      </div>
    </section>

    <main class="py-8">
      <!-- Story + Sidebar -->
      <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-3 gap-8 items-start">
        <div class="md:col-span-2">
          <p class="text-gray-700 dark:text-gray-300">
            Human Rhythm Health focuses on what compounds: sleep, movement, nutrition, light, environment, and relationships.
            We keep plans realistic and seasonal—matched to your responsibilities and energy.
          </p>
          <p class="mt-4 text-gray-700 dark:text-gray-300">
            Our approach blends circadian rhythm basics, strength and mobility, and environment design. The result is a rhythm you can keep—clarity over intensity, consistency over novelty.
          </p>
          <p class="mt-4 text-gray-700 dark:text-gray-300">
            You don’t need a new identity. You need a rhythm.
          </p>
        </div>
        <aside>
          <div class="rounded-lg border border-gray-200 dark:border-gray-800 p-6 bg-white dark:bg-gray-950">
            <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Coach</h2>
            <p class="mt-2 text-gray-700 dark:text-gray-300">
              Concept by Dan Ryan Neff — coordination, systems, and design for better operations.
            </p>
            <p class="mt-2 text-gray-700 dark:text-gray-300">
              Friends and partners: sleep clinicians, strength coaches, and nutrition advisors.
            </p>
          </div>
        </aside>
      </section>

      <!-- Values -->
      <section class="mt-12 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-serif font-bold text-gray-900 dark:text-white">Values</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {[
            { title: "Clarity first", desc: "Simple plans beat perfect plans. We keep the next step obvious." },
            { title: "Sustainable pace", desc: "Progress without burnout—adjusted to your season of life." },
            { title: "Environment matters", desc: "Light, air, and sound shape behavior. We tune your space." },
          ].map((v) => (
            <div class="rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-6">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{v.title}</h3>
              <p class="mt-2 text-gray-700 dark:text-gray-300">{v.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- CTA -->
      <section class="py-12">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
          <h2 class="text-2xl font-serif font-bold text-gray-900 dark:text-white">Ready to explore a rhythm that fits?</h2>
          <div class="mt-5 flex gap-3 justify-center">
            <a href="/concept/human-rhythm-health/programs/" class="hrh-btn hrh-btn-primary">See programs</a>
            <a href="/concept/human-rhythm-health/contact/" class="hrh-btn hrh-btn-secondary">Book a chat</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-stone-100 dark:border-gray-800">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 text-sm text-gray-600 dark:text-gray-400">
        © {new Date().getFullYear()} Human Rhythm Health — Example concept
      </div>
    </footer>

    <!-- Toggle behavior -->
    <script is:inline>
      const btn = document.getElementById('theme-toggle');
      if (btn) {
        btn.addEventListener('click', () => {
          const root = document.documentElement;
          const nowDark = root.classList.toggle('dark');
          try { localStorage.setItem('theme', nowDark ? 'dark' : 'light'); } catch (_) {}
        });
      }
    </script>
  </body>
</html>
