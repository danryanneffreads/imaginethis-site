---
import HumanRhythmHealthLayout from '@/layouts/HumanRhythmHealthLayout.astro';

const title = 'About — Human Rhythm Health';
const description =
  'Human Rhythm Health helps people build simple, durable rhythms for sleep, movement, meals, light, environment, and connection.';
---

<HumanRhythmHealthLayout
  title={title}
  description={description}
  activePage="about"
>
  <!-- Textured intro -->
  <section class="relative py-16">
    <img
      src="/images/health/botanical-textures2.webp"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover -z-10"
    />
    <div class="absolute inset-0 -z-10 bg-white/85 dark:bg-gray-950/70"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-serif font-bold text-gray-900 dark:text-white">
        About Human Rhythm Health
      </h1>
      <p class="mt-3 max-w-2xl text-gray-700 dark:text-gray-300">
        A practical approach to health built around rhythm, environment, and
        real life.
      </p>
    </div>
  </section>

  <!-- Approach -->
  <section class="py-12">
    <div
      class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-3 gap-8 items-start"
    >
      <div>
        <h2 class="text-2xl font-serif font-bold text-gray-900 dark:text-white">
          Our approach
        </h2>
      </div>

      <div class="md:col-span-2">
        <p class="text-gray-700 dark:text-gray-300">
          Human Rhythm Health focuses on the daily patterns that shape how
          people feel: sleep, movement, meals, light, recovery, environment, and
          connection.
        </p>
        <p class="mt-4 text-gray-700 dark:text-gray-300">
          The goal is not to overhaul your life overnight. The goal is to find
          simple anchors that fit your responsibilities, energy, and season of
          life — then repeat them long enough for them to become supportive.
        </p>
        <p class="mt-4 text-gray-700 dark:text-gray-300">
          You do not need a new identity. You need a rhythm you can keep.
        </p>
      </div>
    </div>
  </section>

  <!-- Real life -->
  <section class="py-12 bg-stone-50 dark:bg-gray-900">
    <div
      class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-10 items-center"
    >
      <div
        class="rounded-lg overflow-hidden border border-gray-200 dark:border-gray-800"
      >
        <img
          src="/images/health/wellness_studio_open.webp"
          alt="Spacious wellness studio with arched glass doors opening to trees and natural light"
          class="w-full h-80 object-cover"
          loading="lazy"
        />
      </div>

      <div>
        <h2 class="text-3xl font-serif font-bold text-gray-900 dark:text-white">
          Designed for real life
        </h2>
        <p class="mt-3 text-gray-700 dark:text-gray-300">
          Good health habits should reduce friction, not add pressure. We help
          people build routines that work around jobs, families, changing
          energy, imperfect weeks, and ordinary interruptions.
        </p>
        <p class="mt-4 text-gray-700 dark:text-gray-300">
          That means clear plans, flexible expectations, and steady support —
          with enough structure to create momentum and enough room to stay
          human.
        </p>
      </div>
    </div>
  </section>

  <!-- Environment -->
  <section class="py-12">
    <div
      class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-10 items-center"
    >
      <div>
        <h2 class="text-3xl font-serif font-bold text-gray-900 dark:text-white">
          Environment shapes behavior
        </h2>
        <p class="mt-3 text-gray-700 dark:text-gray-300">
          Light, sound, air, space, and social context all influence how easy or
          difficult your habits become.
        </p>
        <p class="mt-4 text-gray-700 dark:text-gray-300">
          Whether we are looking at your morning routine, your sleep setup, your
          movement plan, or the spaces where you spend most of your time, we
          treat environment as part of the health plan — not an afterthought.
        </p>
      </div>

      <div
        class="rounded-lg overflow-hidden border border-gray-200 dark:border-gray-800"
      >
        <img
          src="/images/health/wellness_studio.webp"
          alt="Sunlit wellness studio with floor cushions, plants, and a wooden bench"
          class="w-full h-80 object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-12 bg-stone-50 dark:bg-gray-900">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-serif font-bold text-gray-900 dark:text-white">
        Values
      </h2>

      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          [
            {
              title: 'Clarity over complexity',
              desc: 'Simple plans beat perfect plans. We keep the next step obvious.',
            },
            {
              title: 'Consistency over intensity',
              desc: 'The rhythm you can repeat usually matters more than the heroic week you cannot sustain.',
            },
            {
              title: 'Sustainable pace',
              desc: 'Progress should fit your season of life instead of demanding that you become someone else.',
            },
            {
              title: 'Environment matters',
              desc: 'Light, air, sound, space, and relationships shape behavior every day.',
            },
            {
              title: 'Support without pressure',
              desc: 'Accountability should help you return to the path, not make you afraid to fall off it.',
            },
            {
              title: 'Health is lived weekly',
              desc: 'Real change shows up in ordinary mornings, meals, walks, evenings, and recoveries.',
            },
          ].map((value) => (
            <div class="rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-6">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
                {value.title}
              </h3>
              <p class="mt-2 text-gray-700 dark:text-gray-300">{value.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-serif font-bold text-gray-900 dark:text-white">
        Ready to build a rhythm that fits?
      </h2>
      <p class="mt-2 text-gray-700 dark:text-gray-300">
        Start with a simple conversation about your current routines and what
        you want to feel more consistently.
      </p>
      <div class="mt-6 flex gap-3 justify-center">
        <a
          href="/concept/human-rhythm-health/programs/"
          class="hrh-btn hrh-btn-primary"
        >
          See programs
        </a>
        <a
          href="/concept/human-rhythm-health/contact/"
          class="hrh-btn hrh-btn-secondary"
        >
          Book a chat
        </a>
      </div>
    </div>
  </section>
</HumanRhythmHealthLayout>
