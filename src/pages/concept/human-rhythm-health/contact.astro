---
import HumanRhythmHealthLayout from '@/layouts/HumanRhythmHealthLayout.astro';

const title = 'Contact — Human Rhythm Health';
const description =
  'Contact Human Rhythm Health to book a chat, ask a question, or choose the right starting point.';
---

<HumanRhythmHealthLayout
  title={title}
  description={description}
  activePage="contact"
>
  <section class="py-16">
    <div
      class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-3 gap-10"
    >
      <!-- Contact methods -->
      <section class="lg:col-span-2">
        <h1 class="text-3xl font-serif font-bold text-gray-900 dark:text-white">
          Contact
        </h1>
        <p class="mt-2 text-gray-700 dark:text-gray-300">
          Questions, a first conversation, or help choosing the right program —
          send a note.
        </p>

        <div class="mt-8 grid sm:grid-cols-2 gap-6">
          <div
            class="rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-6"
          >
            <h2 class="text-lg font-semibold text-gray-900 dark:text-white">
              Email
            </h2>
            <p class="mt-2">
              <a href="mailto:hello@humanrhythm.example" class="hrh-link">
                hello@humanrhythm.example
              </a>
            </p>
          </div>

          <div
            class="rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-6"
          >
            <h2 class="text-lg font-semibold text-gray-900 dark:text-white">
              Response time
            </h2>
            <p class="mt-2 text-gray-700 dark:text-gray-300">
              Most messages receive a reply within 1–2 business days.
            </p>
          </div>
        </div>

        <!-- Visual-only form -->
        <form
          class="mt-8 rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-6"
          onsubmit="return false;"
        >
          <h2 class="text-lg font-semibold text-gray-900 dark:text-white">
            Send a message
          </h2>

          <div class="mt-4 grid sm:grid-cols-2 gap-4">
            <div>
              <label
                for="name"
                class="block text-sm text-gray-700 dark:text-gray-300"
              >
                Name
              </label>
              <input
                id="name"
                name="name"
                type="text"
                class="mt-1 w-full rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-3 py-2 text-gray-900 dark:text-white"
                placeholder="Your name"
              />
            </div>

            <div>
              <label
                for="email"
                class="block text-sm text-gray-700 dark:text-gray-300"
              >
                Email
              </label>
              <input
                id="email"
                name="email"
                type="email"
                class="mt-1 w-full rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-3 py-2 text-gray-900 dark:text-white"
                placeholder="you@example.com"
              />
            </div>
          </div>

          <div class="mt-4">
            <label
              for="interest"
              class="block text-sm text-gray-700 dark:text-gray-300"
            >
              What are you interested in?
            </label>
            <select
              id="interest"
              name="interest"
              class="mt-1 w-full rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-3 py-2 text-gray-900 dark:text-white"
            >
              <option>28-Day Rhythm Reset</option>
              <option>Strength & Mobility Track</option>
              <option>Sleep Reset</option>
              <option>Not sure yet</option>
            </select>
          </div>

          <div class="mt-4">
            <label
              for="message"
              class="block text-sm text-gray-700 dark:text-gray-300"
            >
              Message
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              class="mt-1 w-full rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-3 py-2 text-gray-900 dark:text-white"
              placeholder="Tell us what you are hoping to improve or understand."
            ></textarea>
          </div>

          <div class="mt-5 flex flex-wrap gap-3">
            <a
              href="mailto:hello@humanrhythm.example"
              class="hrh-btn hrh-btn-primary"
            >
              Email us
            </a>
            <a
              href="/concept/human-rhythm-health/programs/"
              class="hrh-btn hrh-btn-secondary"
            >
              See programs
            </a>
          </div>
        </form>
      </section>

      <!-- Sidebar -->
      <aside>
        <div
          class="rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 overflow-hidden"
        >
          <img
            src="/images/health/tea-with-plants.webp"
            alt="Steaming mug of tea surrounded by plants in soft light"
            class="w-full h-40 object-cover"
          />

          <div class="p-6">
            <h2 class="text-lg font-semibold text-gray-900 dark:text-white">
              A good first step
            </h2>
            <p class="mt-2 text-gray-700 dark:text-gray-300">
              Start by sharing what feels hardest to keep consistent right now —
              sleep, energy, movement, meals, recovery, or rhythm.
            </p>

            <div class="mt-5 rounded-md bg-stone-50 dark:bg-gray-900 p-4">
              <h3 class="text-sm font-semibold text-gray-900 dark:text-white">
                Common starting points
              </h3>
              <ul
                class="mt-2 text-sm text-gray-700 dark:text-gray-300 space-y-1 list-disc pl-5"
              >
                <li>Low energy or inconsistent sleep</li>
                <li>Wanting to move more without overdoing it</li>
                <li>Rebuilding routines after a stressful season</li>
                <li>Needing a realistic weekly plan</li>
              </ul>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>
</HumanRhythmHealthLayout>
