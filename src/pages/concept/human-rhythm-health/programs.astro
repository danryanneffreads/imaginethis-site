---
import HumanRhythmHealthLayout from '@/layouts/HumanRhythmHealthLayout.astro';

const title = 'Programs — Human Rhythm Health';
const description =
  'Choose a practical starting point for sleep, movement, meals, light, and recovery.';
---

<HumanRhythmHealthLayout
  title={title}
  description={description}
  activePage="programs"
>
  <!-- Textured intro -->
  <section class="relative py-16">
    <img
      src="/images/health/botanical-textures.webp"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover -z-10"
    />
    <div class="absolute inset-0 -z-10 bg-white/85 dark:bg-gray-950/70"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-serif font-bold text-gray-900 dark:text-white">
        Programs
      </h1>
      <p class="mt-2 text-gray-700 dark:text-gray-300 max-w-2xl">
        Choose a starting point. Each program is built around practical anchors
        you can repeat, adjust, and sustain.
      </p>
    </div>
  </section>

  <section class="py-12">
    <div
      class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3"
    >
      <!-- Reset -->
      <div
        id="reset"
        class="rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-6 flex flex-col"
      >
        <img
          src="/images/health/breakfast-coffee.webp"
          alt="Morning bowl with oats, blueberries, spinach, and nuts beside a cup of coffee in sunlight"
          class="w-full h-40 object-cover rounded-md"
        />
        <h2 class="mt-4 text-xl font-semibold text-gray-900 dark:text-white">
          28-Day Rhythm Reset
        </h2>
        <p class="mt-2 text-gray-700 dark:text-gray-300 flex-1">
          A guided month to rebuild your daily anchors: sleep, light, meals,
          movement, and recovery.
        </p>
        <ul
          class="mt-3 text-sm text-gray-700 dark:text-gray-300 space-y-1 list-disc pl-5"
        >
          <li>Daily check-ins</li>
          <li>Sleep and light tuning</li>
          <li>Simple weekly movement plan</li>
        </ul>
        <a
          href="/concept/human-rhythm-health/contact/"
          class="mt-4 hrh-btn hrh-btn-primary"
        >
          Start the reset
        </a>
      </div>

      <!-- Strength & Mobility -->
      <div
        class="rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-6 flex flex-col"
      >
        <img
          src="/images/health/wellness_studio.webp"
          alt="Sunlit wellness studio with floor cushions, plants, and a wooden bench"
          class="w-full h-40 object-cover rounded-md"
        />
        <h2 class="mt-4 text-xl font-semibold text-gray-900 dark:text-white">
          Strength & Mobility Track
        </h2>
        <p class="mt-2 text-gray-700 dark:text-gray-300 flex-1">
          Small-group coaching for people who want to feel stronger, steadier,
          and more capable.
        </p>
        <ul
          class="mt-3 text-sm text-gray-700 dark:text-gray-300 space-y-1 list-disc pl-5"
        >
          <li>Two coached sessions per week</li>
          <li>At-home accessory work</li>
          <li>Progress tracking without pressure</li>
        </ul>
        <a
          href="/concept/human-rhythm-health/contact/"
          class="mt-4 hrh-btn hrh-btn-secondary"
        >
          Join a group
        </a>
      </div>

      <!-- Sleep Reset -->
      <div
        class="rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-6 flex flex-col"
      >
        <img
          src="/images/health/tea-with-plants.webp"
          alt="Steaming mug of tea on a rustic wood bench surrounded by plants in soft morning light"
          class="w-full h-40 object-cover rounded-md"
        />
        <h2 class="mt-4 text-xl font-semibold text-gray-900 dark:text-white">
          Sleep Reset
        </h2>
        <p class="mt-2 text-gray-700 dark:text-gray-300 flex-1">
          A focused two-week process to improve your wind-down, sleep
          environment, and daily rhythm cues.
        </p>
        <ul
          class="mt-3 text-sm text-gray-700 dark:text-gray-300 space-y-1 list-disc pl-5"
        >
          <li>Wind-down routine</li>
          <li>Light, sound, and space tuning</li>
          <li>Follow-up session</li>
        </ul>
        <a
          href="/concept/human-rhythm-health/contact/"
          class="mt-4 hrh-btn hrh-btn-secondary"
        >
          Book consult
        </a>
      </div>
    </div>
  </section>

  <!-- Choosing section -->
  <section class="py-12 bg-stone-50 dark:bg-gray-900">
    <div
      class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-3 gap-8"
    >
      <div>
        <h2 class="text-2xl font-serif font-bold text-gray-900 dark:text-white">
          Not sure where to start?
        </h2>
      </div>

      <div class="md:col-span-2">
        <p class="text-gray-700 dark:text-gray-300">
          Most people begin with the 28-Day Rhythm Reset. It gives us a clear
          picture of your current routines and helps you build a foundation
          before adding more specialized work.
        </p>
        <p class="mt-4 text-gray-700 dark:text-gray-300">
          If sleep is the main issue, start with Sleep Reset. If you already
          have decent routines but want more strength, stability, and support,
          start with Strength & Mobility.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-serif font-bold text-gray-900 dark:text-white">
        Begin with the rhythm that fits your life now.
      </h2>
      <p class="mt-2 text-gray-700 dark:text-gray-300">
        A short conversation can help you choose the right starting point.
      </p>
      <div class="mt-6 flex gap-3 justify-center">
        <a
          href="/concept/human-rhythm-health/contact/"
          class="hrh-btn hrh-btn-primary"
        >
          Book a chat
        </a>
        <a
          href="/concept/human-rhythm-health/about/"
          class="hrh-btn hrh-btn-secondary"
        >
          Learn the approach
        </a>
      </div>
    </div>
  </section>
</HumanRhythmHealthLayout>
