---
import '@/styles/global.css';
import '@/styles/hrh.css';
status: "published";
const isExample = Astro.url?.pathname?.startsWith("/concept/");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Programs — Human Rhythm Health</title>
    <meta name="description" content="Choose a starting point—28‑Day Rhythm Reset, Strength & Mobility Track, or Sleep Clinic (Lite). Aligned to your season of life." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Initial theme (dark/light) -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          const useDark = stored ? stored === 'dark' : prefersDark;
          document.documentElement.classList.toggle('dark', useDark);
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="bg-white dark:bg-gray-950 dark:text-white" style="font-family: Inter, system-ui, sans-serif">
    {isExample && (
      <div class="bg-indigo-50 text-indigo-900 border-b border-indigo-200 px-4 py-2 text-sm text-center">
        Example concept site (public showcase)
      </div>
    )}

    <!-- Header -->
    <header class="bg-white/90 dark:bg-gray-950/70 backdrop-blur sticky top-0 z-50 border-b border-stone-100 dark:border-gray-800">
      <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
        <div class="flex items-center gap-4">
          <a href="/" class="text-xs text-gray-500 dark:text-gray-400 hover:text-teal-700 dark:hover:text-teal-400 transition">ImagineThis.Site</a>
          <span class="text-gray-300 dark:text-gray-600">/</span>
          <a href="/concept/human-rhythm-health/" class="text-2xl font-serif font-bold hover:opacity-90 transition" style="color: var(--hrh-forest)">Human Rhythm Health</a>
        </div>
        <div class="flex items-center gap-3">
          <ul class="hidden md:flex gap-6 text-gray-700 dark:text-gray-300 items-center">
            <li><a href="/concept/human-rhythm-health/" class="hover:text-teal-700 dark:hover:text-teal-400 transition font-medium">Home</a></li>
            <li><a href="/concept/human-rhythm-health/programs/" class="text-teal-700 dark:text-teal-400 font-semibold">Programs</a></li>
            <li><a href="/concept/human-rhythm-health/studio/" class="hover:text-teal-700 dark:hover:text-teal-400 transition font-medium">Studio</a></li>
            <li><a href="/concept/human-rhythm-health/about/" class="hover:text-teal-700 dark:hover:text-teal-400 transition font-medium">About</a></li>
            <li><a href="/concept/human-rhythm-health/contact/" class="hover:text-teal-700 dark:hover:text-teal-400 transition font-medium">Contact</a></li>
          </ul>

          <!-- Dark mode toggle -->
          <button
            id="theme-toggle"
            type="button"
            class="p-2 rounded-lg hover:bg-stone-100 dark:hover:bg-gray-800 transition"
            aria-label="Toggle dark mode"
            title="Toggle dark mode"
          >
            <!-- Sun (shows in dark mode) -->
            <svg class="hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.364 6.364-1.414-1.414M7.05 7.05 5.636 5.636m12.728 0L17.95 7.05M7.05 16.95l-1.414 1.414M12 8.25a3.75 3.75 0 1 1 0 7.5 3.75 3.75 0 0 1 0-7.5Z"/>
            </svg>
            <!-- Moon (shows in light mode) -->
            <svg class="block dark:hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/>
            </svg>
          </button>
        </div>
      </nav>
      <div class="hrh-accent"></div>
    </header>

    <!-- Textured intro -->
    <section class="relative py-16">
      <img src="/images/health/botanical-textures.webp" alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover -z-10" />
      <div class="absolute inset-0 -z-10 bg-white/85 dark:bg-gray-950/70"></div>
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl font-serif font-bold text-gray-900 dark:text-white">Programs</h1>
        <p class="mt-2 text-gray-700 dark:text-gray-300 max-w-2xl">Choose a starting point. We align your plan to your season of life.</p>
      </div>
    </section>

    <main class="py-6">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <!-- Reset -->
        <div id="reset" class="rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-6 flex flex-col">
          <img src="/images/health/breakfast-coffee.webp" alt="Morning bowl with oats, blueberries, spinach, and nuts beside a cup of coffee in sunlight" class="w-full h-40 object-cover rounded-md" />
          <h2 class="mt-4 text-xl font-semibold text-gray-900 dark:text-white">28‑Day Rhythm Reset</h2>
          <p class="mt-2 text-gray-700 dark:text-gray-300 flex-1">Daily prompts, anchors for sleep and meals, and a simple movement plan.</p>
          <ul class="mt-3 text-sm text-gray-700 dark:text-gray-300 space-y-1 list-disc pl-5">
            <li>Daily check‑ins</li>
            <li>Sleep/light tuning</li>
            <li>2× strength + 2× walks/week</li>
          </ul>
          <a href="/concept/human-rhythm-health/contact/" class="mt-4 hrh-btn hrh-btn-primary">Start the Reset</a>
        </div>

        <!-- Strength & Mobility -->
        <div class="rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-6 flex flex-col">
          <img src="/images/health/wellness_studio.webp" alt="Sunlit wellness studio with floor cushions, plants, and a wooden bench" class="w-full h-40 object-cover rounded-md" />
          <h2 class="mt-4 text-xl font-semibold text-gray-900 dark:text-white">Strength & Mobility Track</h2>
          <p class="mt-2 text-gray-700 dark:text-gray-300 flex-1">Small‑group coaching with take‑home plans. Build capacity that lasts.</p>
          <ul class="mt-3 text-sm text-gray-700 dark:text-gray-300 space-y-1 list-disc pl-5">
            <li>2× coached sessions/week</li>
            <li>Accessory work</li>
            <li>Progress tracking</li>
          </ul>
          <a href="/concept/human-rhythm-health/contact/" class="mt-4 hrh-btn hrh-btn-secondary">Join a group</a>
        </div>

        <!-- Sleep Clinic -->
        <div class="rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-6 flex flex-col">
          <img src="/images/health/tea-with-plants.webp" alt="Steaming mug of tea on a rustic wood bench surrounded by plants in soft morning light" class="w-full h-40 object-cover rounded-md" />
          <h2 class="mt-4 text-xl font-semibold text-gray-900 dark:text-white">Sleep Clinic (Lite)</h2>
          <p class="mt-2 text-gray-700 dark:text-gray-300 flex-1">Environment audit and a two‑week optimization loop with support.</p>
          <ul class="mt-3 text-sm text-gray-700 dark:text-gray-300 space-y-1 list-disc pl-5">
            <li>Wind‑down routine</li>
            <li>Light/noise tuning</li>
            <li>Follow‑up session</li>
          </ul>
          <a href="/concept/human-rhythm-health/contact/" class="mt-4 hrh-btn hrh-btn-secondary">Book consult</a>
        </div>
      </div>
    </main>

    <footer class="border-t border-stone-100 dark:border-gray-800 mt-12">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 text-sm text-gray-600 dark:text-gray-400">
        © {new Date().getFullYear()} Human Rhythm Health — Example concept
      </div>
    </footer>

    <!-- Toggle behavior -->
    <script is:inline>
      const btn = document.getElementById('theme-toggle');
      if (btn) {
        btn.addEventListener('click', () => {
          const root = document.documentElement;
          const nowDark = root.classList.toggle('dark');
          try { localStorage.setItem('theme', nowDark ? 'dark' : 'light'); } catch (_) {}
        });
      }
    </script>
  </body>
</html>
