---
status: 'published';
// Contact page for Synchronize Coffee
import SyncCoffeeLayout from '@/layouts/SyncCoffeeLayout.astro';
---

<SyncCoffeeLayout
  title="Contact - Synchronize Coffee"
  description="Visit Synchronize Coffee, check our hours, or send us a message."
>
  <!-- Hero -->
  <section
    class="relative bg-gradient-to-b from-amber-50 to-white dark:from-blue-950 dark:to-gray-950 py-16 md:py-24 overflow-hidden"
  >
    <div class="absolute inset-0 z-0">
      <img
        src="/images/coffee/coffeeshop-interior.webp"
        alt=""
        class="w-full h-full object-cover opacity-25 dark:opacity-35"
      />
      <div
        class="absolute inset-0 bg-gradient-to-b from-white/65 via-white/40 to-white/10 dark:from-blue-950/65 dark:via-blue-950/45 dark:to-gray-950/60"
      >
      </div>
    </div>

    <div
      class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center"
    >
      <h1
        class="text-4xl md:text-5xl font-serif font-bold text-blue-900 dark:text-blue-200 mb-6"
      >
        Visit Us
      </h1>
      <p
        class="text-lg md:text-xl text-gray-700 dark:text-gray-300 leading-relaxed"
      >
        Whether you're stopping in for a quick coffee or staying for a while,
        we're glad you're here.
      </p>
    </div>
  </section>

  <!-- Visit Us + Details -->
  <section class="py-20 bg-white dark:bg-gray-950">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
        <!-- Details -->
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-[0.2em] text-orange-600 dark:text-orange-400 mb-4"
          >
            Stop by
          </p>

          <h2
            class="text-3xl font-serif font-bold text-blue-900 dark:text-blue-200 mb-4"
          >
            Come find us in the neighborhood.
          </h2>

          <p class="text-gray-700 dark:text-gray-300 leading-relaxed mb-8">
            Grab a morning drink, meet a friend after work, or settle into a
            table for the afternoon. We keep the coffee ready and the room open.
          </p>

          <div class="mb-8">
            <h3
              class="text-lg font-semibold text-blue-900 dark:text-blue-200 mb-2"
            >
              Address
            </h3>
            <p class="text-gray-700 dark:text-gray-300">
              Synchronize Coffee<br />
              247 Maple Street<br />
              Portland, OR 97214
            </p>
          </div>

          <div class="mb-8">
            <h3
              class="text-lg font-semibold text-blue-900 dark:text-blue-200 mb-2"
            >
              Hours
            </h3>
            <ul class="text-gray-700 dark:text-gray-300">
              <li>Mon–Fri: 7:00am – 6:00pm</li>
              <li>Sat–Sun: 8:00am – 6:00pm</li>
            </ul>
          </div>

          <div class="mb-8">
            <h3
              class="text-lg font-semibold text-blue-900 dark:text-blue-200 mb-2"
            >
              Contact
            </h3>
            <p class="text-gray-700 dark:text-gray-300">
              <span class="block">Phone: (503) 555-0125</span>
              <a
                href="mailto:hello@synchronize.coffee"
                class="text-blue-700 dark:text-blue-300 hover:underline"
                >hello@synchronize.coffee</a
              >
            </p>
          </div>

          <div class="flex flex-wrap gap-3">
            <a
              href="/concept/sync-coffee/menu/"
              class="inline-block bg-orange-600 text-white px-5 py-2.5 rounded-md font-semibold hover:bg-orange-700 transition dark:bg-orange-500 dark:hover:bg-orange-400"
              >View Menu</a
            >
            <a
              href="/concept/sync-coffee/order/"
              class="inline-block border border-blue-700 text-blue-700 px-5 py-2.5 rounded-md font-semibold hover:bg-blue-50 transition dark:border-blue-300 dark:text-blue-300 dark:hover:bg-blue-900/30"
              >Order Beans</a
            >
          </div>
        </div>

        <!-- Side image -->
        <div
          class="aspect-[4/3] rounded-2xl overflow-hidden border border-stone-200 dark:border-stone-800"
        >
          <img
            src="/images/coffee/coffee_house_exterior.webp"
            alt="Exterior view of the café with outdoor seating and bicycles"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form -->
  <section class="py-16 bg-white dark:bg-gray-950">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <p
          class="text-sm font-semibold uppercase tracking-[0.2em] text-orange-600 dark:text-orange-400 mb-4"
        >
          Send a note
        </p>
        <h2
          class="text-3xl font-serif font-bold text-blue-900 dark:text-blue-200 mb-4"
        >
          Have a Question?
        </h2>
        <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
          Questions about visits, reservations, performances, or artwork? This
          is a good place to start.
        </p>
      </div>

      <form
        action="/concept/sync-coffee/demo-confirmation/?type=contact"
        method="post"
        class="grid grid-cols-1 gap-5"
      >
        <div>
          <label
            for="name"
            class="block text-sm font-medium text-gray-800 dark:text-gray-200 mb-1"
            >Name</label
          >
          <input
            id="name"
            name="name"
            type="text"
            required
            class="w-full rounded-md border border-stone-300 dark:border-stone-700 bg-white dark:bg-gray-900 px-3 py-2 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-600 dark:focus:ring-blue-400"
          />
        </div>

        <div>
          <label
            for="email"
            class="block text-sm font-medium text-gray-800 dark:text-gray-200 mb-1"
            >Email</label
          >
          <input
            id="email"
            name="email"
            type="email"
            required
            class="w-full rounded-md border border-stone-300 dark:border-stone-700 bg-white dark:bg-gray-900 px-3 py-2 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-600 dark:focus:ring-blue-400"
          />
        </div>

        <div>
          <label
            for="message"
            class="block text-sm font-medium text-gray-800 dark:text-gray-200 mb-1"
            >Message</label
          >
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="w-full rounded-md border border-stone-300 dark:border-stone-700 bg-white dark:bg-gray-900 px-3 py-2 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-600 dark:focus:ring-blue-400"
          ></textarea>
        </div>

        <div
          class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
        >
          <p class="text-sm text-gray-600 dark:text-gray-400">
            We usually reply within one business day.
          </p>
          <button
            type="submit"
            class="bg-orange-600 text-white px-6 py-2.5 rounded-md font-semibold hover:bg-orange-700 transition dark:bg-orange-500 dark:hover:bg-orange-400"
          >
            Send Message
          </button>
        </div>
      </form>
    </div>
  </section>

  <!-- Specialized requests -->
  <section class="py-16 bg-amber-50 dark:bg-blue-950/40">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2
        class="text-3xl md:text-4xl font-serif font-bold text-blue-900 dark:text-blue-200 mb-4"
      >
        Looking for Something Specific?
      </h2>
      <p
        class="text-lg text-gray-700 dark:text-gray-300 mb-6 max-w-3xl mx-auto"
      >
        Use one of these request forms if you already know what you want to
        plan.
      </p>

      <div class="flex flex-wrap gap-3 justify-center">
        <a
          href="/concept/sync-coffee/reserve/"
          class="inline-block bg-orange-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-orange-700 transition dark:bg-orange-500 dark:hover:bg-orange-400"
          >Reserve a Space</a
        >
        <a
          href="/concept/sync-coffee/perform/"
          class="inline-block border border-blue-700 text-blue-700 px-6 py-3 rounded-lg font-semibold hover:bg-blue-50 transition dark:border-blue-300 dark:text-blue-300 dark:hover:bg-blue-900/30"
          >Book a Performance</a
        >
        <a
          href="/concept/sync-coffee/submit-art/"
          class="inline-block border border-blue-700 text-blue-700 px-6 py-3 rounded-lg font-semibold hover:bg-blue-50 transition dark:border-blue-300 dark:text-blue-300 dark:hover:bg-blue-900/30"
          >Submit Art</a
        >
      </div>
    </div>
  </section>
</SyncCoffeeLayout>
