---
status: 'published';
// Home page for Synchronize Coffee concept site
import SyncCoffeeLayout from '@/layouts/SyncCoffeeLayout.astro';
---

<SyncCoffeeLayout
  title="Synchronize Coffee - Community Coffee Roastery & Third Space"
  description="Synchronize Coffee — coffee, creativity, and community in rhythm."
>
  <!-- Video Hero -->
  <section
    class="relative bg-gradient-to-b from-amber-50 to-white dark:from-blue-950 dark:to-gray-950 py-24 md:py-32 overflow-hidden"
  >
    <!-- Background video -->
    <video
      id="hero-video"
      class="absolute inset-0 z-0 w-full h-full object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/images/coffee/coffee-steam.webp"
      aria-hidden="true"
    >
      <source
        src="/images/coffee/steam_rising_from_coffee.mp4"
        type="video/mp4"
      />
      Your browser does not support the video tag.
    </video>

    <!-- Stronger readability overlay -->
    <div
      class="absolute inset-0 z-10 pointer-events-none bg-gradient-to-b from-black/60 via-black/45 to-black/30 dark:from-blue-950/70 dark:via-blue-950/60 dark:to-gray-950/65"
    >
    </div>

    <!-- Hero content -->
    <div
      class="relative z-20 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center md:-mt-10 lg:-mt-14"
    >
      <h1
        class="text-5xl md:text-6xl font-serif font-bold text-white dark:text-blue-200 drop-shadow-lg mb-6"
      >
        Find Your Rhythm
      </h1>

      <p
        class="text-xl md:text-2xl font-medium text-white drop-shadow-lg max-w-3xl mx-auto leading-relaxed mb-10"
      >
        Coffee is the starting point. Community is the destination.
      </p>

      <div class="flex gap-4 justify-center flex-wrap">
        <a
          href="/concept/sync-coffee/order/"
          class="inline-block bg-orange-600 text-white px-8 py-3 font-semibold rounded-lg hover:bg-orange-700 transition dark:bg-orange-500 dark:hover:bg-orange-400"
          >Order Coffee</a
        >
        <a
          href="/concept/sync-coffee/about/"
          class="inline-block border border-white/70 text-white px-8 py-3 font-semibold rounded-lg hover:bg-white/10 transition dark:border-blue-300 dark:text-blue-300 dark:hover:bg-blue-900/30"
          >Our Story</a
        >
      </div>
    </div>

    <!-- Control: play/pause -->
    <div
      class="absolute z-30 bottom-6 left-1/2 -translate-x-1/2 flex items-center gap-3"
    >
      <button
        id="hero-toggle"
        type="button"
        class="px-2 py-1 text-xs rounded-md bg-white/30 text-white ring-1 ring-white/40 hover:bg-white/40 dark:bg-blue-900/50 dark:hover:bg-blue-900/70"
      >
        Pause
      </button>
    </div>
  </section>

  <!-- Identity Section -->
  <section class="py-20 bg-white dark:bg-gray-950">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p
        class="text-sm font-semibold uppercase tracking-[0.2em] text-orange-600 dark:text-orange-400 mb-4"
      >
        More than a coffee shop
      </p>
      <h2
        class="text-3xl md:text-4xl font-serif font-bold text-blue-900 dark:text-blue-200 mb-6"
      >
        A place to gather, linger, create, and connect.
      </h2>
      <div
        class="space-y-5 text-lg text-gray-700 dark:text-gray-300 leading-relaxed"
      >
        <p>
          Synchronize Coffee is built around the kind of café experience people
          remember: good coffee, familiar faces, local art, shared tables, and
          conversations that unfold naturally.
        </p>
        <p>
          Some people come for a morning pour-over. Some come to work for an
          afternoon, meet a friend, share their art, or bring music and stories
          into the room.
        </p>
        <p>The coffee matters. So does everything that can happen around it.</p>
      </div>
    </div>
  </section>

  <!-- Ways to Participate -->
  <section class="py-16 bg-amber-50 dark:bg-blue-950/40">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2
          class="text-3xl md:text-4xl font-serif font-bold text-blue-900 dark:text-blue-200 mb-3"
        >
          Ways to Participate
        </h2>
        <p class="text-lg text-gray-700 dark:text-gray-300 max-w-2xl mx-auto">
          Whether you are stopping in, stocking up, sharing work, or planning a
          gathering, Synchronize gives you a clear place to begin.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        <article
          class="rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-gray-900 p-6 md:p-7 shadow-sm"
        >
          <h3
            class="text-2xl font-serif font-bold text-blue-900 dark:text-blue-200 mb-2"
          >
            Bring the Coffee Home
          </h3>
          <p class="text-gray-700 dark:text-gray-300 mb-5">
            Order fresh-roasted beans, choose your grind, and keep the rhythm of
            the café going from your own kitchen.
          </p>
          <a
            href="/concept/sync-coffee/order/"
            class="inline-block bg-orange-600 text-white px-5 py-2.5 rounded-md font-semibold hover:bg-orange-700 transition dark:bg-orange-500 dark:hover:bg-orange-400"
            >Order Beans</a
          >
        </article>

        <article
          class="rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-gray-900 p-6 md:p-7 shadow-sm"
        >
          <h3
            class="text-2xl font-serif font-bold text-blue-900 dark:text-blue-200 mb-2"
          >
            Share Your Art
          </h3>
          <p class="text-gray-700 dark:text-gray-300 mb-5">
            Local artists help shape the room. Submit work for the rotating
            gallery and let the neighborhood encounter what you make.
          </p>
          <a
            href="/concept/sync-coffee/submit-art/"
            class="inline-block border border-blue-700 text-blue-700 px-5 py-2.5 rounded-md font-semibold hover:bg-blue-50 transition dark:border-blue-300 dark:text-blue-300 dark:hover:bg-blue-900/30"
            >Submit Work</a
          >
        </article>

        <article
          class="rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-gray-900 p-6 md:p-7 shadow-sm"
        >
          <h3
            class="text-2xl font-serif font-bold text-blue-900 dark:text-blue-200 mb-2"
          >
            Bring Something Into the Room
          </h3>
          <p class="text-gray-700 dark:text-gray-300 mb-5">
            Music, poetry, storytelling, and small performances belong here.
            Send a booking request and tell us what you would like to share.
          </p>
          <a
            href="/concept/sync-coffee/perform/"
            class="inline-block border border-blue-700 text-blue-700 px-5 py-2.5 rounded-md font-semibold hover:bg-blue-50 transition dark:border-blue-300 dark:text-blue-300 dark:hover:bg-blue-900/30"
            >Book a Performance</a
          >
        </article>

        <article
          class="rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-gray-900 p-6 md:p-7 shadow-sm"
        >
          <h3
            class="text-2xl font-serif font-bold text-blue-900 dark:text-blue-200 mb-2"
          >
            Make Space for a Gathering
          </h3>
          <p class="text-gray-700 dark:text-gray-300 mb-5">
            Reserve a cozy corner, community table, or meeting nook for focused
            work, small groups, and conversations that need a place to land.
          </p>
          <a
            href="/concept/sync-coffee/reserve/"
            class="inline-block bg-orange-600 text-white px-5 py-2.5 rounded-md font-semibold hover:bg-orange-700 transition dark:bg-orange-500 dark:hover:bg-orange-400"
            >Reserve a Space</a
          >
        </article>
      </div>
    </div>
  </section>

  <!-- Concept Note -->
  <section class="py-16 bg-white dark:bg-gray-950">
    <div
      class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-2 gap-10 items-center"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.2em] text-orange-600 dark:text-orange-400 mb-4"
        >
          What this concept shows
        </p>
        <h2
          class="text-3xl md:text-4xl font-serif font-bold text-blue-900 dark:text-blue-200 mb-4"
        >
          An imagined coffee shop. Real website possibilities.
        </h2>
        <p class="text-gray-700 dark:text-gray-300 leading-relaxed mb-4">
          Synchronize Coffee is a concept business, but the opportunities are
          real: telling a story, inviting participation, handling requests, and
          helping people understand the life of a place before they walk through
          the door.
        </p>
        <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
          This example explores how a neighborhood coffee shop website could
          become more than a simple online listing. It can act as an extension
          of the space itself.
        </p>
      </div>

      <div
        class="aspect-[4/3] rounded-2xl overflow-hidden border border-stone-200 dark:border-stone-800"
      >
        <img
          src="/images/coffee/coffeeshop-interior.webp"
          alt="Coffee shop interior with bar, seating, plants, and tall windows"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="py-16 bg-amber-50 dark:bg-blue-950/40">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2
        class="text-3xl md:text-4xl font-serif font-bold text-blue-900 dark:text-blue-200 mb-4"
      >
        Come Find Your Rhythm
      </h2>
      <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed mb-6">
        Stop by for coffee, share your work, reserve a table, or bring something
        creative into the room.
      </p>
      <a
        href="/concept/sync-coffee/contact/"
        class="inline-block bg-orange-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-orange-700 transition dark:bg-orange-500 dark:hover:bg-orange-400"
      >
        Get in Touch
      </a>
    </div>
  </section>

  <!-- From the Café -->
  <section class="py-16 bg-white dark:bg-gray-950">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <header class="mb-6 text-center">
        <h2
          class="text-3xl md:text-4xl font-serif font-bold text-blue-900 dark:text-blue-200"
        >
          From the Café
        </h2>
        <p class="text-gray-700 dark:text-gray-300 mt-2">
          Scenes, craft, and textures from Synchronize.
        </p>
      </header>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 md:gap-6"
      >
        <div class="aspect-square overflow-hidden rounded-xl">
          <img
            src="/images/coffee/coffee-steam.webp"
            alt="Blue ceramic mug with rising coffee steam on a wooden table"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="aspect-square overflow-hidden rounded-xl">
          <img
            src="/images/coffee/coffee-ceramic-handmade-mug.webp"
            alt="Handcrafted ceramic mug with turquoise glaze on a rustic wooden table"
            class="w-full h-full object-cover object-right"
          />
        </div>
        <div class="aspect-square overflow-hidden rounded-xl">
          <img
            src="/images/coffee/square-golden.webp"
            alt="Ornate golden square pattern with red border on a dark background"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="aspect-square overflow-hidden rounded-xl">
          <img
            src="/images/coffee/coffeeshop-interior.webp"
            alt="Coffee shop interior with bar, seating, plants, and tall windows"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="aspect-square overflow-hidden rounded-xl">
          <img
            src="/images/coffee/beautiful_wood_table.webp"
            alt=""
            role="presentation"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="aspect-square overflow-hidden rounded-xl">
          <img
            src="/images/coffee/blueswirl.webp"
            alt="Abstract blue and white fluid swirl pattern"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Video hero behavior script -->
  <script is:inline>
    const video = document.getElementById('hero-video');
    const toggleBtn = document.getElementById('hero-toggle');

    video.playbackRate = 0.75;

    const stored = localStorage.getItem('heroMotion');
    const prefersReduced = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;
    const saveData = navigator.connection && navigator.connection.saveData;

    let allowAutoplay = stored
      ? stored === 'on'
      : !(prefersReduced || saveData);

    function updateButton() {
      const playing = !video.paused && !video.ended;
      toggleBtn.textContent = playing ? 'Pause' : 'Play';
      toggleBtn.setAttribute('aria-pressed', playing ? 'true' : 'false');
    }

    async function setPlaying(shouldPlay) {
      if (shouldPlay) {
        try {
          await video.play();
        } catch (err) {
          // Autoplay might be blocked
        }
      } else {
        video.pause();
      }
      updateButton();
    }

    if (!allowAutoplay) {
      video.pause();
      video.removeAttribute('autoplay');
      updateButton();
    } else {
      setPlaying(true);
    }

    let wasPlaying = false;
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            if (wasPlaying && allowAutoplay) setPlaying(true);
          } else {
            wasPlaying = !video.paused;
            setPlaying(false);
          }
        }
      },
      { threshold: 0.5 }
    );
    io.observe(video);

    toggleBtn.addEventListener('click', () => {
      const wantPlay = video.paused;
      allowAutoplay = wantPlay;
      localStorage.setItem('heroMotion', wantPlay ? 'on' : 'off');
      setPlaying(wantPlay);
    });

    video.addEventListener('play', updateButton);
    video.addEventListener('pause', updateButton);
    updateButton();
  </script>
</SyncCoffeeLayout>
