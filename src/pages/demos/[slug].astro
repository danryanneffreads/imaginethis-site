---
status: "published"
// demos/[slug].astro
// Dynamic route for private concept demo previews
// Each demo is a file-based secret URL — unguessable slug, no enumeration in nav

import DemoLayout from "../../layouts/DemoLayout.astro";

// Pregenerate demo pages from data files
// In a real workflow: scan demos/ data directory, build pages for each slug
export async function getStaticPaths() {
  // For now, return empty paths — will add demo data files in future
  // This prevents build errors while we set up the system
  return [];
}

interface Props {
  businessName?: string;
}

const { slug } = Astro.params;

// In a real deployment, businessName would come from a data file, URL param, or frontmatter
// For now, extract it from URL or use a default. Start simple.
// Example: /demos/abc123xyz/ could look up a data file with the slug
const businessName = slug ? slug.replace(/-/g, " ") : "Your Business";
---

<DemoLayout 
  title={`Concept: ${businessName} - ImagineThis.Site`}
  description={`A custom concept website design for ${businessName}`}
>
  <!-- Concept Demo Banner -->
  <div class="bg-amber-100 border-b-2 border-amber-700 py-4">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-center text-gray-900 font-semibold">
        🎨 A concept designed for <span class="text-amber-900">{businessName}</span>
      </p>
      <p class="text-center text-sm text-gray-700 mt-1">
        This is a mockup showing design possibilities. Not a representation of your actual website.
      </p>
    </div>
  </div>

  <!-- Main content area - use this space to build out the demo -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Welcome to Your Concept</h1>
      <p class="text-lg text-gray-600 mb-8">
        This private preview is designed specifically for {businessName}. 
        It shows what a thoughtfully designed website could do for your business.
      </p>
      <p class="text-gray-500 text-sm">
        Questions? Get in touch to discuss next steps.
      </p>
    </div>
  </section>
</DemoLayout>
