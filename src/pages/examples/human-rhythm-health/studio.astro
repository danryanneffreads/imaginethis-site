---
import '@/styles/global.css';
import '@/styles/hrh.css';
status: "published";
const isExample = Astro.url?.pathname?.startsWith("/examples/");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Studio — Human Rhythm Health</title>
    <meta name="description" content="Open space, warm wood, and calm light for breath, mobility, and strength. See the Human Rhythm Health studio." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Initial theme (dark/light) -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          const useDark = stored ? stored === 'dark' : prefersDark;
          document.documentElement.classList.toggle('dark', useDark);
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="bg-white dark:bg-gray-950 dark:text-white" style="font-family: Inter, system-ui, sans-serif">
    {isExample && (
      <div class="bg-indigo-50 text-indigo-900 border-b border-indigo-200 px-4 py-2 text-sm text-center">
        Example concept site (public showcase)
      </div>
    )}

    <!-- Header -->
    <header class="bg-white/90 dark:bg-gray-950/70 backdrop-blur sticky top-0 z-50 border-b border-stone-100 dark:border-gray-800">
      <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
        <div class="flex items-center gap-4">
          <a href="/" class="text-xs text-gray-500 dark:text-gray-400 hover:text-teal-700 dark:hover:text-teal-400 transition">ImagineThis.Site</a>
          <span class="text-gray-300 dark:text-gray-600">/</span>
          <a href="/examples/human-rhythm-health/" class="text-2xl font-serif font-bold hover:opacity-90 transition" style="color: var(--hrh-forest)">Human Rhythm Health</a>
        </div>
        <div class="flex items-center gap-3">
          <ul class="hidden md:flex gap-6 text-gray-700 dark:text-gray-300 items-center">
            <li><a href="/examples/human-rhythm-health/" class="hover:text-teal-700 dark:hover:text-teal-400 transition font-medium">Home</a></li>
            <li><a href="/examples/human-rhythm-health/programs/" class="hover:text-teal-700 dark:hover:text-teal-400 transition font-medium">Programs</a></li>
            <li><a href="/examples/human-rhythm-health/studio/" class="text-teal-700 dark:text-teal-400 font-semibold">Studio</a></li>
            <li><a href="/examples/human-rhythm-health/about/" class="hover:text-teal-700 dark:hover:text-teal-400 transition font-medium">About</a></li>
            <li><a href="/examples/human-rhythm-health/contact/" class="hover:text-teal-700 dark:hover:text-teal-400 transition font-medium">Contact</a></li>
          </ul>

          <!-- Dark mode toggle -->
          <button
            id="theme-toggle"
            type="button"
            class="p-2 rounded-lg hover:bg-stone-100 dark:hover:bg-gray-800 transition"
            aria-label="Toggle dark mode"
            title="Toggle dark mode"
          >
            <!-- Sun (shows in dark mode) -->
            <svg class="hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.364 6.364-1.414-1.414M7.05 7.05 5.636 5.636m12.728 0L17.95 7.05M7.05 16.95l-1.414 1.414M12 8.25a3.75 3.75 0 1 1 0 7.5 3.75 3.75 0 0 1 0-7.5Z"/>
            </svg>
            <!-- Moon (shows in light mode) -->
            <svg class="block dark:hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/>
            </svg>
          </button>
        </div>
      </nav>
      <div class="hrh-accent"></div>
    </header>

    <!-- Hero -->
    <section class="relative">
      <img
        src="/images/health/wellness_studio_open.webp"
        alt="Spacious stone-walled studio with arched glass doors opening to trees and natural light."
        class="w-full h-[60vh] sm:h-[72vh] object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/45 via-black/15 to-transparent"></div>
      <div class="absolute inset-x-0 bottom-8">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-white">
          <h1 class="text-3xl sm:text-4xl font-serif font-bold">The Studio</h1>
          <p class="mt-2 text-white/85 max-w-2xl">Open space, warm wood, and calm light for breath and movement.</p>
        </div>
      </div>
    </section>

    <main class="py-12">
      <!-- About the space -->
      <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-10 items-start">
          <div>
            <h2 class="text-2xl font-serif font-bold text-gray-900 dark:text-white">Designed for clarity</h2>
            <p class="mt-3 text-gray-700 dark:text-gray-300">
              Quiet textures, natural light, and simple setups help you focus on breath, posture, and movement.
              Sessions are small so you can move at a sustainable pace with real feedback.
            </p>
            <ul class="mt-4 space-y-2 text-gray-700 dark:text-gray-300 list-disc pl-5">
              <li>Morning and early-evening sessions</li>
              <li>Strength + mobility circuits, guided breathwork</li>
              <li>Environment tuned for air, light, and sound</li>
            </ul>
            <div class="mt-6 flex gap-3">
              <a href="/examples/human-rhythm-health/programs/" class="hrh-btn hrh-btn-primary">Explore programs</a>
              <a href="/examples/human-rhythm-health/contact/" class="hrh-btn hrh-btn-secondary">Book a chat</a>
            </div>
          </div>
          <div class="rounded-lg overflow-hidden border border-gray-200 dark:border-gray-800">
            <img
              src="/images/health/wellness_studio.webp"
              alt="Sunlit wellness studio with floor cushions, plants, and a wooden bench."
              class="w-full h-80 object-cover"
            />
          </div>
        </div>
      </section>

      <!-- Amenities and schedule -->
      <section class="mt-12 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-8">
        <div class="rounded-lg border border-gray-200 dark:border-gray-800 p-6 bg-white dark:bg-gray-950">
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white">Amenities</h3>
          <ul class="mt-3 space-y-2 text-gray-700 dark:text-gray-300 list-disc pl-5">
            <li>Strength and mobility stations</li>
            <li>Filtered water, mats, and props</li>
            <li>Changing area and storage</li>
          </ul>
        </div>
        <div class="rounded-lg border border-gray-200 dark:border-gray-800 p-6 bg-white dark:bg-gray-950">
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white">Schedule</h3>
          <ul class="mt-3 space-y-2 text-gray-700 dark:text-gray-300 list-disc pl-5">
            <li>Mon/Wed/Fri mornings</li>
            <li>Tue/Thu evenings</li>
            <li>Saturday foundations</li>
          </ul>
        </div>
      </section>

      <!-- Gallery -->
      <section class="mt-12 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-serif font-bold text-gray-900 dark:text-white">Gallery</h2>
        <div class="mt-4 grid grid-cols-2 md:grid-cols-3 gap-4">
          <img src="/images/health/wellness_studio.webp" alt="Studio — cushions and plants" class="rounded-lg border border-gray-200 dark:border-gray-800 object-cover w-full h-40" loading="lazy" />
          <img src="/images/health/tea-with-plants.webp" alt="Studio detail — tea and plants" class="rounded-lg border border-gray-200 dark:border-gray-800 object-cover w-full h-40" loading="lazy" />
          <img src="/images/health/breakfast-coffee.webp" alt="Nutrition setup — breakfast bowl and coffee" class="rounded-lg border border-gray-200 dark:border-gray-800 object-cover w-full h-40" loading="lazy" />
        </div>
      </section>

      <!-- Visit CTA -->
      <section class="py-12">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
          <h2 class="text-2xl font-serif font-bold text-gray-900 dark:text-white">Visit the studio</h2>
          <p class="mt-2 text-gray-700 dark:text-gray-300">123 Daylight Ave, Suite 2 • Your City</p>
          <div class="mt-5 flex gap-3 justify-center">
            <a href="/examples/human-rhythm-health/contact/" class="hrh-btn hrh-btn-primary">Book a chat</a>
            <a href="/examples/human-rhythm-health/programs/" class="hrh-btn hrh-btn-secondary">See programs</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-stone-100 dark:border-gray-800">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 text-sm text-gray-600 dark:text-gray-400">
        © {new Date().getFullYear()} Human Rhythm Health — Example concept
      </div>
    </footer>

    <!-- Toggle behavior -->
    <script is:inline>
      const btn = document.getElementById('theme-toggle');
      if (btn) {
        btn.addEventListener('click', () => {
          const root = document.documentElement;
          const nowDark = root.classList.toggle('dark');
          try { localStorage.setItem('theme', nowDark ? 'dark' : 'light'); } catch (_) {}
        });
      }
    </script>
  </body>
</html>
