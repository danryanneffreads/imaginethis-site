---
// FILE: src/pages/examples/sync-coffee/perform/confirmed.astro
status: "published"
import SyncCoffeeLayout from "@/layouts/SyncCoffeeLayout.astro";
---

<SyncCoffeeLayout 
  title="Performance Request Received - Synchronize Coffee"
  description="Your performance booking request has been received."
>
  <section class="py-32 bg-gradient-to-b from-amber-50 to-white dark:from-blue-950 dark:to-gray-950">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-5xl font-serif font-bold text-blue-900 dark:text-blue-200 mb-4">Booking Received!</h1>
      <p class="text-xl text-gray-700 dark:text-gray-300 mb-8 leading-relaxed">
        Thank you for your interest in performing. Our events team will follow up within one business day with next steps.
      </p>

      <div class="bg-amber-50 dark:bg-amber-950 border-l-4 border-amber-500 p-6 mb-12 text-left rounded-r-md">
        <p class="text-amber-800 dark:text-amber-200 text-sm">
          <strong>Concept Demo:</strong> This site is a demo by ImagineThis.Site. No real booking has been made.
        </p>
      </div>

      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/examples/sync-coffee/perform/" class="inline-block bg-orange-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-orange-700 transition dark:bg-orange-500 dark:hover:bg-orange-400">Submit Another</a>
        <a href="/examples/sync-coffee/reserve/" class="inline-block border border-blue-700 text-blue-700 px-6 py-3 rounded-lg font-semibold hover:bg-blue-50 transition dark:border-blue-300 dark:text-blue-300 dark:hover:bg-blue-900/30">Reserve a Space</a>
        <a href="/examples/sync-coffee/" class="inline-block border border-blue-700 text-blue-700 px-6 py-3 rounded-lg font-semibold hover:bg-blue-50 transition dark:border-blue-300 dark:text-blue-300 dark:hover:bg-blue-900/30">Back to Home</a>
      </div>
    </div>
  </section>
</SyncCoffeeLayout>