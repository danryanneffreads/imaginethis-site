---
status: "published"
// Reserve page for Synchronize Coffee
import SyncCoffeeLayout from "@/layouts/SyncCoffeeLayout.astro";
---

<SyncCoffeeLayout 
  title="Reserve a Space - Synchronize Coffee"
  description="Reserve a meeting space or work area at Synchronize Coffee."
>
  <!-- Hero (blueswirl abstract) -->
  <section class="relative overflow-hidden py-16 md:py-24 bg-white dark:bg-gray-950">
    <div class="absolute inset-0 z-0">
      <img src="/images/coffee/blueswirl.webp" alt="" role="presentation" class="w-full h-full object-cover opacity-25 dark:opacity-30">
      <div class="absolute inset-0 bg-gradient-to-b from-white/70 via-white/40 to-white/10 dark:from-blue-950/60 dark:via-blue-950/40 dark:to-gray-950/50"></div>
    </div>
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-serif font-bold text-blue-900 dark:text-blue-200 mb-6">Reserve a Space</h1>
      <p class="text-lg text-gray-700 dark:text-gray-300">Cozy corners, community tables, and meeting rooms.</p>
    </div>
  </section>

  <!-- Reservation form -->
  <section class="py-16 bg-white dark:bg-gray-950">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-serif font-bold text-blue-900 dark:text-blue-200 mb-6 text-center">Request a Reservation</h2>

      <div class="bg-amber-50 dark:bg-amber-950 border-l-4 border-amber-500 p-4 rounded-r-md mb-6">
        <p class="text-amber-800 dark:text-amber-200 text-sm">
          <strong>Concept Demo:</strong> This is a concept site for demonstration. No real reservation will be made.
        </p>
      </div>

      <form action="#" method="post" class="grid grid-cols-1 gap-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-800 dark:text-gray-200 mb-1">Full Name</label>
            <input id="name" name="name" type="text" required class="w-full rounded-md border border-stone-300 dark:border-stone-700 bg-white dark:bg-gray-900 px-3 py-2 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-600 dark:focus:ring-blue-400" />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-gray-800 dark:text-gray-200 mb-1">Email</label>
            <input id="email" name="email" type="email" required class="w-full rounded-md border border-stone-300 dark:border-stone-700 bg-white dark:bg-gray-900 px-3 py-2 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-600 dark:focus:ring-blue-400" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          <div>
            <label for="date" class="block text-sm font-medium text-gray-800 dark:text-gray-200 mb-1">Date</label>
            <input id="date" name="date" type="date" required class="w-full rounded-md border border-stone-300 dark:border-stone-700 bg-white dark:bg-gray-900 px-3 py-2 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-600 dark:focus:ring-blue-400" />
          </div>
          <div>
            <label for="time" class="block text-sm font-medium text-gray-800 dark:text-gray-200 mb-1">Time</label>
            <input id="time" name="time" type="time" required class="w-full rounded-md border border-stone-300 dark:border-stone-700 bg-white dark:bg-gray-900 px-3 py-2 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-600 dark:focus:ring-blue-400" />
          </div>
          <div>
            <label for="party" class="block text-sm font-medium text-gray-800 dark:text-gray-200 mb-1">Party Size</label>
            <input id="party" name="party" type="number" min="1" value="2" required class="w-full rounded-md border border-stone-300 dark:border-stone-700 bg-white dark:bg-gray-900 px-3 py-2 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-600 dark:focus:ring-blue-400" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="space" class="block text-sm font-medium text-gray-800 dark:text-gray-200 mb-1">Space Type</label>
            <select id="space" name="space" class="w-full rounded-md border border-stone-300 dark:border-stone-700 bg-white dark:bg-gray-900 px-3 py-2 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-600 dark:focus:ring-blue-400">
              <option>Cozy Corner (2–3)</option>
              <option>Community Table (4–6)</option>
              <option>Meeting Table (6–8)</option>
              <option>Whole Nook (up to 12)</option>
            </select>
          </div>
          <div>
            <label for="needs" class="block text-sm font-medium text-gray-800 dark:text-gray-200 mb-1">Special Needs</label>
            <select id="needs" name="needs" class="w-full rounded-md border border-stone-300 dark:border-stone-700 bg-white dark:bg-gray-900 px-3 py-2 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-600 dark:focus:ring-blue-400">
              <option>None</option>
              <option>Power outlets</option>
              <option>Quiet area</option>
              <option>Near entrance</option>
              <option>Wheelchair space</option>
            </select>
          </div>
        </div>

        <div>
          <label for="notes" class="block text-sm font-medium text-gray-800 dark:text-gray-200 mb-1">Notes</label>
          <textarea id="notes" name="notes" rows="4" class="w-full rounded-md border border-stone-300 dark:border-stone-700 bg-white dark:bg-gray-900 px-3 py-2 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-600 dark:focus:ring-blue-400" placeholder="Anything else we should know?"></textarea>
        </div>

        <div class="flex items-center justify-between">
          <p class="text-sm text-gray-600 dark:text-gray-400">We’ll confirm by email within one business day.</p>
          <button type="submit" class="bg-orange-600 text-white px-6 py-2.5 rounded-md font-semibold hover:bg-orange-700 transition dark:bg-orange-500 dark:hover:bg-orange-400">
            Submit Request
          </button>
        </div>
      </form>
    </div>
  </section>

  <!-- Spaces overview -->
  <section class="py-14 bg-white dark:bg-gray-950">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-serif font-bold text-blue-900 dark:text-blue-200 mb-6 text-center">Spaces at Synchronize</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <article class="rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-gray-900 p-5 text-center">
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Cozy Corners</h3>
          <p class="text-gray-700 dark:text-gray-300">Perfect for pairs and quiet work sessions.</p>
        </article>
        <article class="rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-gray-900 p-5 text-center">
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Community Tables</h3>
          <p class="text-gray-700 dark:text-gray-300">Gather, collaborate, and meet new people.</p>
        </article>
        <article class="rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-gray-900 p-5 text-center">
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Meeting Nooks</h3>
          <p class="text-gray-700 dark:text-gray-300">A bit more privacy for small groups.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- CTA band -->
  <section class="py-16 bg-amber-50 dark:bg-blue-950/40">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-blue-900 dark:text-blue-200 mb-4">Need Something Specific?</h2>
      <p class="text-lg text-gray-700 dark:text-gray-300 mb-6">Tell us what you’re planning — we’ll help make it happen.</p>
      <a href="/examples/sync-coffee/contact/" class="inline-block bg-orange-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-orange-700 transition dark:bg-orange-500 dark:hover:bg-orange-400">Contact Us</a>
    </div>
  </section>
</SyncCoffeeLayout>
