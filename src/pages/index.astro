---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import CTASection from "../components/CTASection.astro";

// Examples to display on the homepage grid.
// Titles are clickable and each card shows an image.
const examples = [
  {
    title: "Synchronize Coffee",
    description:
      "A warm, community‑focused coffee shop concept with clear events and simple paths to visit and engage.",
    link: "/concept/sync-coffee/",
    imageSrc: "/images/coffee/coffee_house_exterior.webp",
    imageAlt: "Coffee house exterior with people talking and parked bicycles",
  },
  {
    title: "AI & Human Systems Summit",
    description:
      "A premium one‑page event site with themes, program, timeline, pricing, partners, and a confident CTA rhythm.",
    link: "/concept/human-ai-systems-summit/",
    imageSrc: "/images/summit/atrium-human-ai-summit.webp",
    imageAlt: "Futuristic atrium with people gathered",
  },
  {
    title: "Human Rhythm Health",
    description:
      "Programs, studio, and habits aligned to your biology—sleep, movement, meals, and light.",
    link: "/concept/human-rhythm-health/",
    imageSrc: "/images/health/bicycling-person-trees.webp",
    imageAlt: "Cyclist under tree canopy in warm afternoon light",
  },
];
---

<Layout
  title="ImagineThis.Site - Websites Built on How You Serve"
  description="Design, prototype, and ship concept sites that reflect how you actually serve people — so the website works with your operations, not against them."
>
  <Hero
    title="Make your website reflect how you actually serve people."
    subtitle="When a site matches your real operations, everything gets easier — customers understand you faster, trust you sooner, and know the next step. That's the point."
    smallText="Over 20 years I've coordinated teams, improved operations, and built systems. The website is part of that system."
    cta_text="See Examples"
    cta_link="#examples"
  />

  <section id="concept" class="py-16 bg-stone-50 dark:bg-gray-900">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-serif font-bold text-gray-900 dark:text-white mb-8">Examples</h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {examples.map((ex) => (
          <article class="group rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 overflow-hidden hover:shadow-sm transition flex flex-col">
            {ex.imageSrc && (
              <a href={ex.link} aria-label={`${ex.title} — open`}>
                <img src={ex.imageSrc} alt={ex.imageAlt} class="w-full h-44 object-cover" loading="lazy" />
              </a>
            )}
            <div class="p-6 flex-1 flex flex-col">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
                <a href={ex.link} class="hover:underline">{ex.title}</a>
              </h3>
              {ex.description && <p class="mt-2 text-gray-700 dark:text-gray-300 flex-1">{ex.description}</p>}
              <div class="mt-3">
                <a href={ex.link} class="text-emerald-700 dark:text-emerald-400 hover:underline font-medium">Learn more</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    heading="I'm Dan. If you want a website that matches how you actually serve people, let's talk."
    description="We can prototype a focused concept, or map the path from vision to launch. Either way, it should help real work happen."
    button_text="Send me a message"
    button_link="mailto:danryanneff@gmail.com"
    dark={false}
  />
</Layout>
