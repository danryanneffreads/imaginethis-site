---
// pages/index.astro
// Home page - showcases ImagineThis.Site with sophisticated black/white design

import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Card from "../components/Card.astro";
import CTASection from "../components/CTASection.astro";
---

<Layout title="ImagineThis.Site - Websites Built on How You Serve" description="Your website is part of your business operations. When it reflects how you actually serve people, everything gets easier.">
  <!-- Hero Section -->
  <Hero 
    title="Your business at its best is thoughtful and intentional. It guides customers through a great experience. Your website should do the same." 
    subtitle="Over 20 years, I've shaped how organizations work — coordinating teams, improving operations, building systems. A website is part of that system. When it reflects how you actually serve people, everything gets easier. When it doesn't, it holds you back."
    smallText="There are a lot of ways to build a website. We figure out what's right for you — not what's right for me."
    cta_text="Explore"
    cta_link="#idea"
  />

  <!-- The Idea Section -->
  <section id="idea" class="py-20 bg-white dark:bg-gray-950">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 dark:text-white mb-8">Think of your website as an extension of how you serve people.</h2>
        <div class="space-y-6 text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
          <p>Your website does something every time someone visits. Either it helps them understand what you offer, trust you, and take the next step — or it leaves them confused or indifferent. That's not just design. That's how your business functions online.</p>
          <p>When a website is built to reflect how you actually serve customers, it stops being a placeholder and starts working for you.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section class="py-20 bg-gray-50 dark:bg-gray-900">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <div>
          <h3 class="text-2xl font-serif font-bold text-gray-900 dark:text-white mb-4">Understand</h3>
          <p class="text-gray-700 dark:text-gray-300 leading-relaxed">I learn how your business serves customers. What works. What gets in the way. What's missing.</p>
        </div>
        <div>
          <h3 class="text-2xl font-serif font-bold text-gray-900 dark:text-white mb-4">Envision</h3>
          <p class="text-gray-700 dark:text-gray-300 leading-relaxed">I build a concept site showing what's possible. Not a template — a vision tailored to you.</p>
        </div>
        <div>
          <h3 class="text-2xl font-serif font-bold text-gray-900 dark:text-white mb-4">Decide</h3>
          <p class="text-gray-700 dark:text-gray-300 leading-relaxed">You choose what's next. Hand it off to a developer. Build it yourself. Or let me teach you how. The tools follow your needs.</p>
        </div>
      </div>
      <p class="text-center text-gray-600 dark:text-gray-400 italic mt-16 pt-12 border-t border-gray-200 dark:border-gray-800">
        Sometimes I build a concept before being asked — just to show what's possible. If you receive one, it means I see something in your business worth exploring.
      </p>
    </div>
  </section>

  <!-- Examples Section -->
  <section id="examples" class="py-20 bg-white dark:bg-gray-950">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 dark:text-white mb-12">Imagine what's possible</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <Card 
          title="Synchronize Coffee"
          description="A coffee shop whose online presence matches the warmth of walking in the door. Online menu syncs with the in-store experience."
          image="https://picsum.photos/400/300?random=1"
          link="#"
        />
        <Card 
          title="Inventive Consultants"
          description="A consultancy where the website reflects how they actually guide clients. Clear process, real outcomes, no generic consulting-speak."
          image="https://picsum.photos/400/300?random=2"
          link="#"
        />
        <Card 
          title="Imagine Architects"
          description="A creative firm where the portfolio and client experience online feel as considered as the work itself."
          image="https://picsum.photos/400/300?random=3"
          link="#"
        />
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <CTASection 
    heading="I'm Dan. I combine operations experience with digital building. If you're curious what your business could look like online, let's talk."
    button_text="Send me a message"
    button_link="mailto:danryanneff@gmail.com"
    dark={false}
  />
</Layout>
