---
// src/pages/index.astro
status: 'published';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';
import CTASection from '../components/CTASection.astro';

// Page meta
const title = 'ImagineThis.Site — Websites Built on How You Serve';
const description =
  'A calm, structured studio for concept sites, private client drafts, and clear resources on modern web building.';

// Concept cards (equal emphasis, with images)
const concepts = [
  {
    title: 'Synchronize Coffee',
    description:
      'A neighborhood coffee roastery and third space. Warm, community-forward structure and flows.',
    link: '/concept/sync-coffee/',
    image: '/images/coffee/coffee-steam.webp',
  },
  {
    title: 'Human Rhythm Health',
    description:
      'A health studio — clear programs, scheduling, and a gentle design system.',
    link: '/concept/human-rhythm-health/',
    image: '/images/health/bicycling-person-trees.webp',
  },
  {
    title: 'Human + AI Systems Summit',
    description: 'An event site for programs, speakers, and schedules.',
    link: '/concept/human-ai-systems-summit/',
    image: '/images/summit/atrium-human-ai-summit.webp',
  },
];
---

<Layout title={title} description={description}>
  <!-- Hero (restored copy) -->
  <Hero
    title="Your website should reflect the quality of your work."
    subtitle="A mediocre website quietly costs you trust, clarity, and opportunities.<br /><br />But when a site matches your real operations, customers understand you faster, trust you sooner, and know the next step."
    smallText="Over 20 years I've coordinated teams, improved operations, and built systems. Your website is part of that system."
  />

  <!-- Section A: How this site works -->
  <section
    class="bg-gradient-to-b from-stone-50 dark:from-gray-900 to-white dark:to-gray-950 py-24 md:py-28"
  >
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p
        class="text-xs uppercase tracking-widest text-gray-500 dark:text-gray-400 mb-3"
      >
        A working space for building websites
      </p>
      <h2
        class="text-4xl md:text-5xl font-serif font-bold text-gray-900 dark:text-white mb-5"
      >
        Part portfolio. Part workshop. Part guide.
      </h2>
      <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
        ImagineThis.Site is where I design concept sites, draft client work, and
        share clear notes on modern web tools.
      </p>
    </div>
  </section>

  <!-- Section B: The three roles -->
  <section class="py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
        <!-- Concept sites -->
        <article
          class="rounded-lg border border-stone-200 dark:border-stone-800 p-6"
        >
          <h3
            class="text-2xl font-serif font-semibold text-gray-900 dark:text-white mb-2"
          >
            Concept sites
          </h3>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            Sites that demonstrate possibilities — structure, tone, and flow.
            Built to show how a website can reflect how you serve people.
          </p>
        </article>

        <!-- Client drafts & prototypes -->
        <article
          class="rounded-lg border border-stone-200 dark:border-stone-800 p-6"
        >
          <h3
            class="text-2xl font-serif font-semibold text-gray-900 dark:text-white mb-2"
          >
            Client drafts & prototypes
          </h3>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            Live drafts for real projects. Shared privately with clients and
            collaborators.
          </p>
          <ul class="list-disc pl-5 space-y-1 text-gray-700 dark:text-gray-300">
            <li>Unlisted URLs, not indexed</li>
          </ul>
        </article>

        <!-- Guides & resources -->
        <article
          class="rounded-lg border border-stone-200 dark:border-stone-800 p-6"
        >
          <h3
            class="text-2xl font-serif font-semibold text-gray-900 dark:text-white mb-2"
          >
            Guides & resources
          </h3>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            Practical explanations of tools, workflows, and tradeoffs — so
            choices become easier.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Section C: Pathways -->
  <section class="py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h4
        class="text-sm uppercase tracking-widest text-gray-500 dark:text-gray-400 mb-6"
      >
        Explore by type
      </h4>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Concepts -->
        <a
          href="/#concepts"
          class="group rounded-lg border border-stone-200 dark:border-stone-800 p-5 hover:bg-stone-50 dark:hover:bg-gray-900 transition"
        >
          <h5 class="text-lg font-semibold text-gray-900 dark:text-white mb-1">
            Concept sites
          </h5>
          <p class="text-gray-700 dark:text-gray-300">
            See selected concept sites and what they enable.
          </p>
        </a>

        <!-- Drafts & prototypes -->
        <div
          class="rounded-lg border border-stone-200 dark:border-stone-800 p-5"
        >
          <h5 class="text-lg font-semibold text-gray-900 dark:text-white mb-1">
            Drafts & prototypes
          </h5>
          <p class="text-gray-700 dark:text-gray-300 mb-2">
            Shared privately with clients. No public index.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="/process"
              class="text-sm font-semibold text-gray-900 dark:text-white underline underline-offset-2 hover:no-underline"
            >
              How drafts work
            </a>
            <a
              href="https://danryanneff.com/work-with-me/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-gray-700 dark:text-gray-300 hover:underline"
            >
              Book a session
            </a>
          </div>
        </div>

        <!-- Guides & resources -->
        <a
          href="/web-builders"
          class="group rounded-lg border border-stone-200 dark:border-stone-800 p-5 hover:bg-stone-50 dark:hover:bg-gray-900 transition"
        >
          <h5 class="text-lg font-semibold text-gray-900 dark:text-white mb-1">
            Guides & resources
          </h5>
          <p class="text-gray-700 dark:text-gray-300">
            Clear, practical notes on modern web building.
          </p>
        </a>
      </div>
    </div>
  </section>

  <!-- Section D: Concept sites (framing + grid with images) -->
  <section
    id="concepts"
    class="py-24 md:py-28 border-t border-stone-200 dark:border-stone-800"
  >
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <p
        class="text-xs uppercase tracking-widest text-gray-500 dark:text-gray-400 mb-3"
      >
        Selected work
      </p>
      <h2
        class="text-3xl md:text-4xl font-serif font-bold text-gray-900 dark:text-white mb-3"
      >
        Concept sites
      </h2>
      <p class="text-gray-700 dark:text-gray-300 mb-10">
        Working examples that show structure, pacing, and language—not just
        visuals.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          concepts.map((c) => (
            <Card
              title={c.title}
              description={c.description}
              link={c.link}
              image={c.image}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Section E: Visibility note -->
  <section class="py-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm text-gray-600 dark:text-gray-400">
        Client drafts are shared via unlisted links and are not indexed by
        search engines.
      </p>
    </div>
  </section>

  <!-- Final CTA -->
  <CTASection
    heading="I'm Dan. If you want a website that matches how you actually serve people, let's talk."
    description="We can prototype a focused concept, or map the path from vision to launch. Either way, it should help real work happen."
    button_text="Send me a message"
    button_link="mailto:danryanneff@gmail.com"
    dark={false}
  />
</Layout>
