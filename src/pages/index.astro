---
// src/pages/index.astro
status: 'published';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import GuidesTeaser from '../components/guides-teaser.astro';
import Card from '../components/Card.astro';
import CTASection from '../components/CTASection.astro';

// Page meta
const title = 'ImagineThis.Site — Websites That Fit the Work';
const description =
  'Explore working concept sites, shape a private draft, and get practical guidance—so your website fits the work behind it.';

// Concept cards
const concepts = [
  {
    title: 'Hearthworks Architecture',
    description:
      'Homes, neighborhood buildings, libraries, workplaces, and community spaces—crafted for daily life.',
    link: '/concept/hearthworks-architecture/',
    image: '/images/architecture/residence-porch.webp',
  },
  {
    title: 'Synchronize Coffee',
    description:
      'A neighborhood coffee roastery and third space. Warm, community-forward structure and flows.',
    link: '/concept/sync-coffee/',
    image: '/images/coffee/coffee-steam.webp',
  },
  {
    title: 'Human Rhythm Health',
    description:
      'A health studio with clear programs, scheduling, and a gentle design system.',
    link: '/concept/human-rhythm-health/',
    image: '/images/health/bicycling-person-trees.webp',
  },
  {
    title: 'Human + AI Systems Summit',
    description:
      'An event site for programs, speakers, schedules, and human-centered technology conversations.',
    link: '/concept/human-ai-systems-summit/',
    image: '/images/summit/atrium-human-ai-summit.webp',
  },
];
---

<Layout title={title} description={description}>
  <Hero
    title="Explore what your website could become."
    subtitle="Try on structures, language, and flows before you commit to a build. When you're ready, we turn the right ideas into a private draft."
    smallText="I'm Dan. I help people explore website ideas and bring the right ones into reality."
    cta_text="Explore concept sites"
    cta_link="#concepts"
  />

  <!-- Concepts first: Working examples -->
  <section
    id="concepts"
    class="py-24 md:py-28 border-t border-stone-200 dark:border-stone-800"
  >
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <p
        class="text-xs uppercase tracking-widest text-gray-500 dark:text-gray-400 mb-3"
      >
        Explore possibilities
      </p>
      <h2
        class="text-3xl md:text-4xl font-serif font-bold text-gray-900 dark:text-white mb-3"
      >
        Explore concept sites
      </h2>
      <p class="text-gray-700 dark:text-gray-300 mb-10">
        These are working examples, not just mockups. They show how structure,
        language, and design can help people quickly understand your work. Pick
        one close to your world and imagine how it could be yours.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          concepts.map((c) => (
            <Card
              title={c.title}
              description={c.description}
              link={c.link}
              image={c.image}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- What this is / How it works -->
  <section
    id="intro"
    class="bg-gradient-to-b from-stone-50 dark:from-gray-900 to-white dark:to-gray-950 py-24 md:py-28"
  >
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p
        class="text-xs uppercase tracking-widest text-gray-500 dark:text-gray-400 mb-3"
      >
        A calm, structured space
      </p>

      <h2
        class="text-4xl md:text-5xl font-serif font-bold text-gray-900 dark:text-white mb-5"
      >
        How this works
      </h2>

      <h3
        class="text-2xl md:text-3xl font-serif font-semibold text-gray-900 dark:text-white mb-5"
      >
        Start with examples. Move to a focused draft.
      </h3>

      <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
        ImagineThis.Site is a place to try on website possibilities. Start by
        exploring public concept sites. When something fits, we shape a private
        draft for your specific work. Along the way, I share practical guidance
        about structure, platforms, and the decisions that shape a successful
        website.
      </p>
    </div>
  </section>

  <!-- The three roles -->
  <section class="py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
        <!-- Concept sites -->
        <article
          class="rounded-lg border border-stone-200 dark:border-stone-800 p-6 bg-amber-50 dark:bg-amber-900/15 hover:bg-amber-50/80 dark:hover:bg-amber-900/20 transition-colors"
        >
          <h3
            class="text-2xl font-serif font-semibold text-gray-900 dark:text-white mb-2"
          >
            Concept sites
          </h3>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            Working examples that show possibilities for structure, tone,
            pacing, and flow. They demonstrate how a site can fit the work
            behind it.
          </p>
          <ul class="list-disc pl-5 space-y-1 text-gray-700 dark:text-gray-300">
            <li>
              <a
                class="text-blue-600 hover:underline dark:text-blue-300"
                href="#concepts">Explore the examples</a
              >
            </li>
          </ul>
        </article>

        <!-- Drafts and prototypes -->
        <article
          class="rounded-lg border border-stone-200 dark:border-stone-800 p-6 bg-blue-50 dark:bg-blue-900/15 hover:bg-blue-50/80 dark:hover:bg-blue-900/20 transition-colors"
        >
          <h3
            class="text-2xl font-serif font-semibold text-gray-900 dark:text-white mb-2"
          >
            Drafts & prototypes
          </h3>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            Private working pages for real projects. A draft can make an idea
            easier to discuss, test, revise, and bring into focus.
          </p>
          <ul class="list-disc pl-5 space-y-1 text-gray-700 dark:text-gray-300">
            <li>Unlisted URLs for clients and collaborators</li>
            <li>
              <a
                class="text-blue-600 hover:underline dark:text-blue-300"
                href="/working-together">How drafts work</a
              >
            </li>
          </ul>
        </article>

        <!-- Guides and resources -->
        <article
          class="rounded-lg border border-stone-200 dark:border-stone-800 p-6 bg-emerald-50 dark:bg-emerald-900/15 hover:bg-emerald-50/80 dark:hover:bg-emerald-900/20 transition-colors"
        >
          <h3
            class="text-2xl font-serif font-semibold text-gray-900 dark:text-white mb-2"
          >
            Guides & resources
          </h3>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            Practical notes on planning, platforms, and tradeoffs. The goal is
            to make website decisions clearer before building begins.
          </p>
          <ul class="list-disc pl-5 space-y-1 text-gray-700 dark:text-gray-300">
            <li>
              <a
                class="text-blue-600 hover:underline dark:text-blue-300"
                href="/guides">Guides & resources</a
              >
            </li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- Guides teaser -->
  <GuidesTeaser
    image_src="/images/door-mandala.webp"
    image_alt="Small abstract badge for Guides"
  />

  <!-- Final CTA -->
  <CTASection
    heading="I'm Dan. I help people figure out the right website and then bring it into reality."
    description="Whether you're starting with a rough idea, exploring possibilities, or ready to build, I can help clarify the path and create a website that fits the work behind it."
    button_text="Send me a message"
    button_link="mailto:danryanneff@gmail.com"
    dark={false}
  />
</Layout>
