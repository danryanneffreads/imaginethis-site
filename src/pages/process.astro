---
// src/pages/process.astro
status: 'published';
import Layout from '../layouts/Layout.astro';

const title = 'Imagine it, privately—then make it real';
const description =
  'An invitation to imagine together—private drafts, unlisted links, and a calm path to a website that reflects the quality of your work.';
---

<Layout title={title} description={description}>
  <!-- Intro -->
  <section
    class="bg-gradient-to-b from-stone-50 dark:from-gray-900 to-white dark:to-gray-950 py-20 md:py-24"
  >
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1
        class="text-4xl md:text-5xl font-serif font-bold text-gray-900 dark:text-white mb-6"
      >
        Imagine it, privately—then make it real
      </h1>
      <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
        Sometimes I send you a private draft. Sometimes you reach out. Either
        way, we think critically about what your website should do—and make it
        reflect the quality of your work.
      </p>
    </div>
  </section>

  <!-- Main content -->
  <section class="py-12 md:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <!-- Two ways we start -->
      <div class="rounded-lg border border-stone-200 dark:border-stone-800 p-6">
        <h2
          class="text-2xl font-serif font-semibold text-gray-900 dark:text-white mb-3"
        >
          Two ways we start
        </h2>
        <div class="space-y-4">
          <div>
            <h3 class="font-medium text-gray-900 dark:text-white">
              I send you a draft
            </h3>
            <p class="text-gray-700 dark:text-gray-300">
              If I see a clear opportunity, I’ll share an unlisted page that
              imagines what your site could be. No pressure. Just a private
              starting point.
            </p>
          </div>
          <div>
            <h3 class="font-medium text-gray-900 dark:text-white">
              You reach out
            </h3>
            <p class="text-gray-700 dark:text-gray-300">
              Tell me what you’re hoping your website will unlock. We’ll sketch
              a first draft quickly and quietly.
            </p>
          </div>
        </div>
      </div>

      <!-- Private by default -->
      <div class="rounded-lg border border-stone-200 dark:border-stone-800 p-6">
        <h2
          class="text-2xl font-serif font-semibold text-gray-900 dark:text-white mb-2"
        >
          Private by default
        </h2>
        <p class="text-gray-700 dark:text-gray-300">
          Draft links are unlisted and not indexed. They’re shared only with the
          people doing the work. Review happens in private, one-on-one loops.
        </p>
      </div>

      <!-- Why we work this way -->
      <div class="rounded-lg border border-stone-200 dark:border-stone-800 p-6">
        <h2
          class="text-2xl font-serif font-semibold text-gray-900 dark:text-white mb-2"
        >
          Why we work this way
        </h2>
        <ul class="list-disc pl-5 space-y-1 text-gray-700 dark:text-gray-300">
          <li>Your website should reflect the quality of your work.</li>
          <li>
            We start from something tangible — a first draft you can react to.
          </li>
          <li>
            We reason together about purpose: who it’s for, what it should
            change, and how we’ll know.
          </li>
        </ul>
      </div>

      <!-- What we’ll discuss -->
      <div class="rounded-lg border border-stone-200 dark:border-stone-800 p-6">
        <h2
          class="text-2xl font-serif font-semibold text-gray-900 dark:text-white mb-2"
        >
          What we’ll discuss
        </h2>
        <ul class="list-disc pl-5 space-y-1 text-gray-700 dark:text-gray-300">
          <li>Purpose: who it serves and what actions matter</li>
          <li>Fit: brand voice, credibility, and proof</li>
          <li>
            Builder choice: Squarespace, Webflow, Framer, or custom — based on
            team, content cadence, autonomy, and needed interactions
          </li>
          <li>
            Working style: done‑for‑you or done‑with‑you (and when I step back)
          </li>
          <li>Stewardship: ongoing care vs. a clean handoff</li>
          <li>Constraints: scope, timeline, budget, approvals</li>
        </ul>
      </div>

      <!-- Paths we can take -->
      <div class="rounded-lg border border-stone-200 dark:border-stone-800 p-6">
        <h2
          class="text-2xl font-serif font-semibold text-gray-900 dark:text-white mb-2"
        >
          Paths we can take
        </h2>
        <ul class="list-disc pl-5 space-y-2 text-gray-700 dark:text-gray-300">
          <li>
            <span class="font-medium text-gray-900 dark:text-white"
              >Fast prototype</span
            > — a fast, focused draft
          </li>
          <li>
            <span class="font-medium text-gray-900 dark:text-white"
              >Done‑for‑You build</span
            > — I build, you review. Ongoing care if you want it.
          </li>
          <li>
            <span class="font-medium text-gray-900 dark:text-white"
              >Done‑With‑You sessions</span
            > — we co‑build; you gain the keys.
          </li>
          <li>
            <span class="font-medium text-gray-900 dark:text-white"
              >Stewardship</span
            > — calm, continuous improvements over time.
          </li>
          <li>
            <span class="font-medium text-gray-900 dark:text-white"
              >Handoff</span
            > — docs, a short walkthrough, and a simple checklist.
          </li>
        </ul>
      </div>

      <!-- CTA -->
      <div class="rounded-lg border border-stone-200 dark:border-stone-800 p-6">
        <h2
          class="text-2xl font-serif font-semibold text-gray-900 dark:text-white mb-2"
        >
          Ready to start a quiet draft?
        </h2>
        <a
          href="https://danryanneff.com/contact/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block text-sm font-semibold underline underline-offset-2 text-gray-900 dark:text-white hover:no-underline"
        >
          Book a meeting
        </a>
      </div>

      <p class="text-sm text-gray-600 dark:text-gray-400">
        Note: Public “concept sites” on this domain demonstrate possibilities;
        live client drafts remain private.
      </p>
    </div>
  </section>
</Layout>
