---
// sync-coffee/contact.astro
// Contact page for Synchronize Coffee

import SyncCoffeeLayout from "../../layouts/SyncCoffeeLayout.astro";
---

<SyncCoffeeLayout 
  title="Contact - Synchronize Coffee"
  description="Get in touch with Synchronize Coffee — visit us, call, or send a message."
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-green-50 dark:from-green-950 to-white dark:to-gray-950 py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-serif font-bold text-green-900 dark:text-green-300 mb-6">Get in Touch</h1>
      <p class="text-lg text-gray-700 dark:text-gray-300">We'd love to hear from you.</p>
    </div>
  </section>

  <section class="py-20 bg-white dark:bg-gray-950">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <!-- Contact Info -->
        <div>
          <h2 class="text-3xl font-serif font-bold text-gray-900 dark:text-white mb-8">Contact Details</h2>

          <div class="mb-10">
            <h3 class="text-lg font-semibold text-green-900 dark:text-green-300 mb-3">📍 Address</h3>
            <p class="text-gray-700 dark:text-gray-300">
              Synchronize Coffee<br />
              247 Maple Street<br />
              Portland, OR 97214
            </p>
          </div>

          <div class="mb-10">
            <h3 class="text-lg font-semibold text-green-900 dark:text-green-300 mb-3">📞 Phone</h3>
            <p class="text-gray-700 dark:text-gray-300">
              <a href="tel:+15035551247" class="hover:text-green-700 dark:hover:text-green-400 transition">(503) 555-1247</a>
            </p>
          </div>

          <div class="mb-10">
            <h3 class="text-lg font-semibold text-green-900 dark:text-green-300 mb-3">⏰ Hours</h3>
            <div class="text-gray-700 dark:text-gray-300 space-y-1">
              <p><strong>Monday - Friday:</strong> 6:30 AM - 9:00 PM</p>
              <p><strong>Saturday:</strong> 7:00 AM - 10:00 PM</p>
              <p><strong>Sunday:</strong> 8:00 AM - 8:00 PM</p>
            </div>
          </div>

          <div class="mb-10">
            <h3 class="text-lg font-semibold text-green-900 dark:text-green-300 mb-3">🚴 Amenities</h3>
            <ul class="text-gray-700 dark:text-gray-300 space-y-2">
              <li>✓ Free WiFi</li>
              <li>✓ Bike parking</li>
              <li>✓ Accessible entrance</li>
              <li>✓ Outdoor seating</li>
              <li>✓ Pet-friendly patio</li>
              <li>✓ Private meeting room</li>
            </ul>
          </div>

          <div>
            <h3 class="text-lg font-semibold text-green-900 dark:text-green-300 mb-3">Follow Us</h3>
            <div class="flex gap-4">
              <a href="#" class="text-green-700 dark:text-green-400 hover:text-green-900 dark:hover:text-green-300 transition">Instagram</a>
              <a href="#" class="text-green-700 dark:text-green-400 hover:text-green-900 dark:hover:text-green-300 transition">Twitter</a>
              <a href="#" class="text-green-700 dark:text-green-400 hover:text-green-900 dark:hover:text-green-300 transition">Facebook</a>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div>
          <h2 class="text-3xl font-serif font-bold text-gray-900 dark:text-white mb-8">Send a Message</h2>
          
          <form class="space-y-6" onsubmit="return handleFormSubmit(event)">
            <div>
              <label for="name" class="block text-sm font-semibold text-gray-900 dark:text-white mb-2">Name</label>
              <input 
                type="text" 
                id="name" 
                name="name"
                class="w-full px-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white rounded focus:outline-none focus:border-green-500 dark:focus:border-green-400 transition"
                placeholder="Your name"
                required
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-semibold text-gray-900 dark:text-white mb-2">Email</label>
              <input 
                type="email" 
                id="email" 
                name="email"
                class="w-full px-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white rounded focus:outline-none focus:border-green-500 dark:focus:border-green-400 transition"
                placeholder="your@email.com"
                required
              />
            </div>

            <div>
              <label for="subject" class="block text-sm font-semibold text-gray-900 dark:text-white mb-2">Subject</label>
              <input 
                type="text" 
                id="subject" 
                name="subject"
                class="w-full px-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white rounded focus:outline-none focus:border-green-500 dark:focus:border-green-400 transition"
                placeholder="What's this about?"
                required
              />
            </div>

            <div>
              <label for="message" class="block text-sm font-semibold text-gray-900 dark:text-white mb-2">Message</label>
              <textarea 
                id="message" 
                name="message"
                rows="5"
                class="w-full px-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white rounded focus:outline-none focus:border-green-500 dark:focus:border-green-400 transition"
                placeholder="Your message..."
                required
              ></textarea>
            </div>

            <button 
              type="submit"
              class="w-full bg-green-700 dark:bg-green-600 text-white px-6 py-3 font-semibold hover:bg-green-800 dark:hover:bg-green-700 transition rounded"
            >
              Send Message
            </button>
          </form>

          <p class="text-sm text-gray-500 dark:text-gray-400 mt-6 text-center">
            💡 This is a demo. Messages won't be sent, but we appreciate the thought!
          </p>
        </div>
      </div>
    </div>
  </section>

  <script>
    function handleFormSubmit(e) {
      e.preventDefault();
      // Redirect to demo confirmation page
      window.location.href = '/sync-coffee/demo-confirmation/?type=contact';
      return false;
    }
  </script>
</SyncCoffeeLayout>
