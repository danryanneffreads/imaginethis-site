---
status: "published"
// sync-coffee/index.astro
// Home page for Synchronize Coffee concept site

import SyncCoffeeLayout from "../../layouts/SyncCoffeeLayout.astro";
---

<SyncCoffeeLayout 
  title="Synchronize Coffee - Community Coffee Roastery & Third Space"
  description="Synchronize Coffee — where the community gathers, artists display work, and everyone finds their rhythm."
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-stone-50 dark:from-emerald-950 to-white dark:to-gray-950 py-24 md:py-32 overflow-hidden">
    <img src="/images/coffee/coffee_house_exterior.webp" alt="" class="absolute inset-0 w-full h-full object-cover opacity-25 dark:opacity-15">
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-5xl md:text-6xl font-serif font-bold text-emerald-900 dark:text-emerald-300 mb-6">Find Your Rhythm</h1>
      <p class="text-xl text-gray-700 dark:text-gray-300 mb-6 max-w-2xl mx-auto leading-relaxed">
        Synchronize Coffee is where community gathers. Good coffee fuels good conversation. Art adorns the walls. And everyone finds their place.
      </p>
      <p class="text-base text-emerald-800 dark:text-emerald-400 mb-10">Your neighborhood third space</p>
    </div>
  </section>

  <!-- Intro Section -->
  <section class="py-20 bg-white dark:bg-gray-950">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-4xl font-serif font-bold text-gray-900 dark:text-white mb-6">More Than Coffee</h2>
        <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed mb-6">
          Synchronize Coffee isn't just about the beans—though those are exceptional. It's a community gathering place where artists display work, musicians perform, cyclists meet, and conversations flow as freely as espresso.
        </p>
        <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
          Whether you're ordering single-origin bags, submitting art for our walls, booking a performance, or just needing a workspace, you belong here.
        </p>
      </div>
    </div>
  </section>

  <!-- Featured Demo Flows -->
  <section class="py-20 bg-stone-50 dark:bg-emerald-950">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-serif font-bold text-gray-900 dark:text-white mb-12 text-center">What You Can Do Here</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Bean Ordering -->
        <div class="bg-white dark:bg-gray-900 p-8 rounded-lg border-l-4 border-emerald-700 dark:border-emerald-400">
          <h3 class="text-2xl font-serif font-bold text-gray-900 dark:text-white mb-3">Order Beans</h3>
          <p class="text-gray-700 dark:text-gray-300 mb-6 leading-relaxed">
            Discover our single-origin roasts and house blends. We ship fresh-roasted beans to your door, or grab a bag in the cafe.
          </p>
          <a href="/sync-coffee/order/" class="inline-block bg-emerald-700 dark:bg-emerald-600 text-white px-6 py-2 font-semibold hover:bg-emerald-800 dark:hover:bg-emerald-700 transition rounded-lg">
            Order Now
          </a>
        </div>

        <!-- Art Submissions -->
        <div class="bg-white dark:bg-gray-900 p-8 rounded-lg border-l-4 border-emerald-700 dark:border-emerald-400">
          <h3 class="text-2xl font-serif font-bold text-gray-900 dark:text-white mb-3">Show Your Art</h3>
          <p class="text-gray-700 dark:text-gray-300 mb-6 leading-relaxed">
            Our walls are a rotating gallery. Local artists display work, find inspiration, and connect with community.
          </p>
          <a href="/sync-coffee/submit-art/" class="inline-block bg-emerald-700 dark:bg-emerald-600 text-white px-6 py-2 font-semibold hover:bg-emerald-800 dark:hover:bg-emerald-700 transition rounded-lg">
            Submit Work
          </a>
        </div>

        <!-- Music Booking -->
        <div class="bg-white dark:bg-gray-900 p-8 rounded-lg border-l-4 border-emerald-700 dark:border-emerald-400">
          <h3 class="text-2xl font-serif font-bold text-gray-900 dark:text-white mb-3">Book a Performance</h3>
          <p class="text-gray-700 dark:text-gray-300 mb-6 leading-relaxed">
            Host a live performance. Coffee, community, and music — a perfect trio. We host musicians, poets, and storytellers.
          </p>
          <a href="/sync-coffee/perform/" class="inline-block bg-emerald-700 dark:bg-emerald-600 text-white px-6 py-2 font-semibold hover:bg-emerald-800 dark:hover:bg-emerald-700 transition rounded-lg">
            Schedule a Time
          </a>
        </div>

        <!-- Room Reservation -->
        <div class="bg-white dark:bg-gray-900 p-8 rounded-lg border-l-4 border-emerald-700 dark:border-emerald-400">
          <h3 class="text-2xl font-serif font-bold text-gray-900 dark:text-white mb-3">Reserve a Space</h3>
          <p class="text-gray-700 dark:text-gray-300 mb-6 leading-relaxed">
            Need a workspace? Host a small meeting? We have cozy corners, community tables, and bike parking out front.
          </p>
          <a href="/sync-coffee/reserve/" class="inline-block bg-emerald-700 dark:bg-emerald-600 text-white px-6 py-2 font-semibold hover:bg-emerald-800 dark:hover:bg-emerald-700 transition rounded-lg">
            Reserve Now
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="py-20 bg-emerald-900 dark:bg-emerald-950 text-white text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-serif font-bold mb-6">Come Find Your Rhythm</h2>
      <p class="text-lg text-stone-100 mb-10 leading-relaxed">
        Stop by in person, order online, or reach out to learn more. We're here, we're connected, and we're always brewing something good.
      </p>
      <a href="/sync-coffee/contact/" class="inline-block bg-white text-emerald-900 px-8 py-3 font-semibold hover:bg-stone-50 transition rounded-lg">
        Get in Touch
      </a>
    </div>
  </section>
</SyncCoffeeLayout>
