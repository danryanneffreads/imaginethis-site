---
// sync-coffee/order/confirmed.astro
// Coffee order confirmation page

import SyncCoffeeLayout from "../../../layouts/SyncCoffeeLayout.astro";
---

<SyncCoffeeLayout 
  title="Order Confirmed - Synchronize Coffee"
  description="Your coffee order has been received."
>
  <section class="py-32 bg-gradient-to-b from-green-50 dark:from-green-950 to-white dark:to-gray-950">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-5xl font-serif font-bold text-green-900 dark:text-green-300 mb-4">
        ☕ Order Confirmed!
      </h1>
      
      <p class="text-xl text-gray-700 dark:text-gray-300 mb-8 leading-relaxed">
        Thank you for your order. Fresh beans are on their way.
      </p>

      <p class="text-base text-gray-600 dark:text-gray-400 mb-12 italic">
        In a real version, you would receive an order confirmation email with tracking information and expected delivery date.
      </p>

      <div class="bg-yellow-50 dark:bg-yellow-950 border-l-4 border-yellow-500 p-6 mb-12 text-left">
        <p class="text-yellow-800 dark:text-yellow-200 text-sm">
          <strong>🎨 Concept Demo:</strong> This is a concept website built by ImagineThis.Site to demonstrate what a thoughtfully designed web presence could do for Synchronize Coffee. No real order has been placed.
        </p>
      </div>

      <a href="/sync-coffee/" class="inline-block bg-green-700 dark:bg-green-600 text-white px-8 py-3 font-semibold hover:bg-green-800 dark:hover:bg-green-700 transition">
        Back to Home
      </a>
    </div>
  </section>
</SyncCoffeeLayout>
