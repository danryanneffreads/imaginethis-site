---
// sync-coffee/order/index.astro
// Coffee ordering page with product showcase and order form

import SyncCoffeeLayout from "../../../layouts/SyncCoffeeLayout.astro";
---

<SyncCoffeeLayout 
  title="Order Coffee - Synchronize Coffee"
  description="Order fresh-roasted Synchronize Coffee beans for home delivery."
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-emerald-50 dark:from-emerald-950 to-white dark:to-gray-950 py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-serif font-bold text-emerald-900 dark:text-emerald-200 mb-6"> Order Our Beans</h1>
      <p class="text-lg text-gray-700 dark:text-gray-300">Fresh-roasted, ethically sourced coffee delivered to your door.</p>
    </div>
  </section>

  <!-- Products -->
  <section class="py-20 bg-white dark:bg-gray-950">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
      <h2 class="text-3xl font-serif font-bold text-gray-900 dark:text-white mb-12">Our Roasts</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- House Blend -->
        <div class="bg-emerald-50 dark:bg-emerald-900 p-8 rounded-lg border border-emerald-200 dark:border-emerald-800">
          <img src="https://picsum.photos/300/300?random=10" alt="Synchronize House Blend Coffee Bag" class="w-full h-64 object-cover rounded mb-6" />
          <h3 class="text-2xl font-serif font-bold text-gray-900 dark:text-white mb-2">Synchronize Blend</h3>
          <p class="text-sm text-emerald-800 dark:text-emerald-200 font-semibold mb-3">$14.99 / 12 oz</p>
          <p class="text-gray-700 dark:text-gray-300 mb-4 text-sm leading-relaxed">
            Our signature house blend. Bright, balanced, with notes of chocolate and citrus. Perfect for any brewing method.
          </p>
          <p class="text-xs text-gray-600 dark:text-gray-400">Medium Roast • 100% Arabica • Fair Trade Certified</p>
        </div>

        <!-- Ethiopian Single Origin -->
        <div class="bg-emerald-50 dark:bg-emerald-900 p-8 rounded-lg border border-emerald-200 dark:border-emerald-800">
          <img src="https://picsum.photos/300/300?random=11" alt="Ethiopian Highlands Coffee Bag" class="w-full h-64 object-cover rounded mb-6" />
          <h3 class="text-2xl font-serif font-bold text-gray-900 dark:text-white mb-2">Ethiopian Highlands</h3>
          <p class="text-sm text-emerald-800 dark:text-emerald-200 font-semibold mb-3">$16.99 / 12 oz</p>
          <p class="text-gray-700 dark:text-gray-300 mb-4 text-sm leading-relaxed">
            Floral, fruity notes with hints of blueberry. Light to medium roast. Limited availability.
          </p>
          <p class="text-xs text-gray-600 dark:text-gray-400">Light Roast • Single-Origin • Direct Trade</p>
        </div>

        <!-- Kenyan Peaberry -->
        <div class="bg-emerald-50 dark:bg-emerald-900 p-8 rounded-lg border border-emerald-200 dark:border-emerald-800">
          <img src="https://picsum.photos/300/300?random=12" alt="Kenyan Peaberry Coffee Bag" class="w-full h-64 object-cover rounded mb-6" />
          <h3 class="text-2xl font-serif font-bold text-gray-900 dark:text-white mb-2">Kenyan Peaberry</h3>
          <p class="text-sm text-emerald-800 dark:text-emerald-200 font-semibold mb-3">$17.99 / 12 oz</p>
          <p class="text-gray-700 dark:text-gray-300 mb-4 text-sm leading-relaxed">
            Bright acidity with fruity notes. Medium roast. Complex and refined.
          </p>
          <p class="text-xs text-gray-600 dark:text-gray-400">Medium Roast • Single-Origin • Small Batch</p>
        </div>
      </div>
    </div>

    <!-- Order Form -->
    <div class="bg-emerald-50 dark:bg-emerald-950 py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-serif font-bold text-gray-900 dark:text-white mb-8 text-center">Place Your Order</h2>
        
        <form class="space-y-6" onsubmit="handleOrderSubmit(event)">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-sm font-semibold text-gray-900 dark:text-white mb-2">Name *</label>
              <input 
                type="text" 
                id="name" 
                name="name"
                class="w-full px-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white rounded focus:outline-none focus:border-green-500 dark:focus:border-emerald-500 transition"
                required
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-semibold text-gray-900 dark:text-white mb-2">Email *</label>
              <input 
                type="email" 
                id="email" 
                name="email"
                class="w-full px-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white rounded focus:outline-none focus:border-green-500 dark:focus:border-emerald-500 transition"
                required
              />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="coffee" class="block text-sm font-semibold text-gray-900 dark:text-white mb-2">Coffee Selection *</label>
              <select 
                id="coffee" 
                name="coffee"
                class="w-full px-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white rounded focus:outline-none focus:border-green-500 dark:focus:border-emerald-500 transition"
                required
              >
                <option value="">Select a coffee</option>
                <option value="house">Synchronize Blend - $14.99</option>
                <option value="ethiopian">Ethiopian Highlands - $16.99</option>
                <option value="kenyan">Kenyan Peaberry - $17.99</option>
              </select>
            </div>

            <div>
              <label for="quantity" class="block text-sm font-semibold text-gray-900 dark:text-white mb-2">Quantity (12 oz bags) *</label>
              <input 
                type="number" 
                id="quantity" 
                name="quantity"
                min="1"
                max="10"
                value="1"
                class="w-full px-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white rounded focus:outline-none focus:border-green-500 dark:focus:border-emerald-500 transition"
                required
              />
            </div>
          </div>

          <div>
            <label for="note" class="block text-sm font-semibold text-gray-900 dark:text-white mb-2">Notes (optional)</label>
            <textarea 
              id="note" 
              name="note"
              rows="3"
              placeholder="Any special requests or preferences?"
              class="w-full px-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white rounded focus:outline-none focus:border-green-500 dark:focus:border-emerald-500 transition"
            ></textarea>
          </div>

          <button 
            type="submit"
            class="w-full bg-emerald-700 dark:bg-emerald-600 text-white px-6 py-4 font-semibold hover:bg-emerald-800 dark:hover:bg-emerald-700 transition rounded"
          >
            Place Order
          </button>
        </form>

        <p class="text-sm text-gray-600 dark:text-gray-400 mt-6 text-center">
          💡 This is a demo. No order information will be collected.
        </p>
      </div>
    </div>
  </section>

  <script>
    function handleOrderSubmit(e) {
      e.preventDefault();
      window.location.href = '/sync-coffee/order/confirmed/';
      return false;
    }
  </script>
</SyncCoffeeLayout>
