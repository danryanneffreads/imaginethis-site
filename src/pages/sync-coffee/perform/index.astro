---
// sync-coffee/perform/index.astro
// Music performance booking form

import SyncCoffeeLayout from "../../../layouts/SyncCoffeeLayout.astro";
---

<SyncCoffeeLayout 
  title="Book a Performance - Synchronize Coffee"
  description="Schedule a live performance at Synchronize Coffee."
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-emerald-50 dark:from-emerald-950 to-white dark:to-gray-950 py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-serif font-bold text-emerald-900 dark:text-emerald-200 mb-6"> Book a Performance</h1>
      <p class="text-lg text-gray-700 dark:text-gray-300">Live music, poetry, storytelling — whatever moves people.</p>
    </div>
  </section>

  <!-- Form Section -->
  <section class="py-20 bg-white dark:bg-gray-950">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-lg text-gray-700 dark:text-gray-300 mb-10 leading-relaxed">
        We host live music, poetry readings, storytelling, and other performances. Our cafe provides an intimate setting where artists connect with community members who care about creativity. Submit your details below and our events team will get back to you within 48 hours to discuss availability and logistics.
      </p>

      <form class="space-y-6 bg-emerald-50 dark:bg-emerald-950 p-8 rounded-lg" onsubmit="handlePerformanceSubmit(event)">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="performer-name" class="block text-sm font-semibold text-gray-900 dark:text-white mb-2">Performer/Band Name *</label>
            <input 
              type="text" 
              id="performer-name" 
              name="performer-name"
              class="w-full px-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white rounded focus:outline-none focus:border-emerald-500 dark:focus:border-emerald-500 transition"
              required
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-semibold text-gray-900 dark:text-white mb-2">Contact Email *</label>
            <input 
              type="email" 
              id="email" 
              name="email"
              class="w-full px-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white rounded focus:outline-none focus:border-emerald-500 dark:focus:border-emerald-500 transition"
              required
            />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="genre" class="block text-sm font-semibold text-gray-900 dark:text-white mb-2">Genre/Style *</label>
            <input 
              type="text" 
              id="genre" 
              name="genre"
              placeholder="e.g., Indie folk, Jazz, Poetry, Spoken word"
              class="w-full px-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white rounded focus:outline-none focus:border-emerald-500 dark:focus:border-emerald-500 transition"
              required
            />
          </div>

          <div>
            <label for="duration" class="block text-sm font-semibold text-gray-900 dark:text-white mb-2">Expected Duration *</label>
            <input 
              type="text" 
              id="duration" 
              name="duration"
              placeholder="e.g., 1 hour, 45 minutes"
              class="w-full px-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white rounded focus:outline-none focus:border-emerald-500 dark:focus:border-emerald-500 transition"
              required
            />
          </div>
        </div>

        <div>
          <label for="available-dates" class="block text-sm font-semibold text-gray-900 dark:text-white mb-2">Available Dates *</label>
          <input 
            type="text" 
            id="available-dates" 
            name="available-dates"
            placeholder="e.g., Weekends in June, Specific dates"
            class="w-full px-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white rounded focus:outline-none focus:border-emerald-500 dark:focus:border-emerald-500 transition"
            required
          />
        </div>

        <div>
          <label for="description" class="block text-sm font-semibold text-gray-900 dark:text-white mb-2">About Your Work</label>
          <textarea 
            id="description" 
            name="description"
            rows="4"
            placeholder="Tell us about your music, your style, and what you'd bring to Synchronize Coffee."
            class="w-full px-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white rounded focus:outline-none focus:border-emerald-500 dark:focus:border-emerald-500 transition"
          ></textarea>
        </div>

        <div>
          <label for="samples-link" class="block text-sm font-semibold text-gray-900 dark:text-white mb-2">Link to Samples (optional)</label>
          <input 
            type="url" 
            id="samples-link" 
            name="samples-link"
            placeholder="Bandcamp, SoundCloud, YouTube, etc."
            class="w-full px-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white rounded focus:outline-none focus:border-emerald-500 dark:focus:border-emerald-500 transition"
          />
        </div>

        <button 
          type="submit"
          class="w-full bg-emerald-700 dark:bg-emerald-600 text-white px-6 py-4 font-semibold hover:bg-emerald-800 dark:hover:bg-emerald-700 transition rounded"
        >
          Submit Performance Request
        </button>
      </form>

      <p class="text-sm text-gray-600 dark:text-gray-400 mt-6 text-center">
        This is a demo. Your information won't be collected.
      </p>
    </div>
  </section>

  <script>
    function handlePerformanceSubmit(e) {
      e.preventDefault();
      window.location.href = '/sync-coffee/perform/confirmed/';
      return false;
    }
  </script>
</SyncCoffeeLayout>
