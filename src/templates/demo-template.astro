// FILE: src/pages/preview/demo-template.astro
---
import DemoLayout from "../../layouts/DemoLayout.astro";

// HOW TO USE:
// 1) Duplicate this file in VS Code (right‑click > Copy, then Paste).
// 2) Rename the copy to a secret slug, e.g., src/pages/preview/x9a7b2c3.astro
// 3) Update the props below and the H1 text.
// 4) Commit, push, and share only the full URL (do not link it publicly).
---

<DemoLayout
  title="Concept Demo — Example Business"
  description="Private concept preview."
  business="Example Business"
>
  <section class="py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 prose dark:prose-invert">
      <h1>Concept Demo for Example Business</h1>
      <p>
        This is a private, unlisted concept preview. Share this URL only with stakeholders.
      </p>

      <h2>Suggested Sections</h2>
      <ul>
        <li>Hero with value proposition and next step</li>
        <li>How it works / What to expect</li>
        <li>Key features or services</li>
        <li>Proof (logos, testimonials, track record)</li>
        <li>Clear CTA</li>
      </ul>
    </div>
  </section>
</DemoLayout>
